@model NiceShop.ViewModels.Admin.OrdersVm.OrderDetailsVm
@using NiceShop.Models

@{
    ViewData["Title"] = $"Order #{Model?.Number}";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var pipeline = new[] { "Pending", "Confirmed", "Shipped", "Delivered" };
    var pipelineIcons = new[] { "bi-bag-check", "bi-box-seam", "bi-truck", "bi-geo-alt-fill" };

    Func<OrderStatus, string> statusClass = s => s.ToString().ToLower() switch
    {
        "pending" => "ns-status-pending",
        "confirmed" => "ns-status-confirmed",
        "shipped" => "ns-status-shipped",
        "delivered" => "ns-status-delivered",
        "cancelled" or "canceled" => "ns-status-cancelled",
        _ => "ns-status-pending"
    };

    Func<OrderStatus, string> statusIcon = s => s.ToString().ToLower() switch
    {
        "pending" => "bi-clock-fill",
        "confirmed" => "bi-check-circle-fill",
        "shipped" => "bi-truck",
        "delivered" => "bi-geo-alt-fill",
        "cancelled" or "canceled" => "bi-x-circle-fill",
        _ => "bi-circle-fill"
    };

    Func<OrderStatus, string> statusDot = s => s.ToString().ToLower() switch
    {
        "pending" => "#f59e0b",
        "confirmed" => "#0ea5e9",
        "shipped" => "#8b5cf6",
        "delivered" => "#16a34a",
        "cancelled" or "canceled" => "#dc2626",
        _ => "#a3a3a3"
    };

    var allStatuses = Enum.GetValues(typeof(OrderStatus)).Cast<OrderStatus>().ToList();

    var items = Model?.Items ?? new List<NiceShop.ViewModels.Admin.OrdersVm.OrderItemVm>();
    var totalUnits = items.Sum(i => i.Quantity);

    var statusName = Model?.Status.ToString().ToLower() ?? "";
    bool isCancelled = statusName == "cancelled" || statusName == "canceled" || Model?.IsCanceled == true;
    int stepIndex = Model is null ? -1 : Array.FindIndex(pipeline, p => string.Equals(p, Model.Status.ToString(), StringComparison.OrdinalIgnoreCase));
}

@if (Model is null)
{
    <div class="ns-admin-card text-center py-5">
        <i class="bi bi-inbox d-block mb-2 text-muted" style="font-size:2.25rem;"></i>
        <div class="fw-bold mb-1">Order not found</div>
        <a asp-action="Orders" class="ns-ghost-btn mt-3"><i class="bi bi-arrow-left"></i> Back to orders</a>
    </div>
    return;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="ns-panel">

    <!-- ===================== PANEL HEADER ===================== -->
    <div class="ns-panel-head">
        <h1 class="ns-panel-title mb-0">Order Details</h1>

        <div class="d-flex align-items-center gap-2 ns-no-print">
            <button type="button" class="ns-ghost-btn" onclick="window.print()" title="Print">
                <i class="bi bi-printer"></i>
            </button>
            <a asp-action="Orders" class="ns-ghost-btn" title="Close">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </div>

    <!-- ===================== PANEL BODY ===================== -->
    <div class="ns-panel-body">

        <!-- ---------- LEFT / MAIN ---------- -->
        <div class="ns-panel-main">

            <!-- Order number + badges -->
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <h2 class="ns-order-number mb-0">#@Model.Number</h2>

                <span class="ns-status-badge @statusClass(Model.Status)">
                    <i class="bi @statusIcon(Model.Status)"></i> @Model.Status
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
                {
                    <span class="ns-coupon"><i class="bi bi-ticket-perforated"></i> @Model.CouponCode</span>
                }
            </div>

            <p class="ns-meta-line mb-4">
                Placed @Model.OrderDate.ToString("MMM dd, yyyy") at @Model.OrderDate.ToString("hh:mm tt")
                &nbsp;·&nbsp; From <span class="fw-bold text-decoration-underline">@Model.CustomerName</span>
            </p>

            <!-- Fulfilment strip -->
            <h3 class="ns-block-title">Fulfilment</h3>
            <div class="ns-track-strip mb-4">
                @if (isCancelled)
                {
                    <div class="ns-track ns-track-cancelled">
                        <span class="ns-track-node done"><i class="bi bi-x-lg"></i></span>
                        <span class="ns-track-line"></span>
                        <span class="ns-track-node"></span>
                        <span class="ns-track-line"></span>
                        <span class="ns-track-node"></span>
                        <span class="ns-track-line"></span>
                        <span class="ns-track-node"></span>
                    </div>
                    <span class="ns-track-caption ns-text-danger fw-bold">Cancelled</span>
                }
                else
                {
                    <div class="ns-track">
                        @for (int i = 0; i < pipeline.Length; i++)
                        {
                            var done = stepIndex >= 0 && i <= stepIndex;
                            if (i > 0)
                            {
                                <span class="ns-track-line @(done ? "done" : "")"></span>
                            }
                            <span class="ns-track-node @(done ? "done" : "")" title="@pipeline[i]">
                                <i class="bi @pipelineIcons[i]"></i>
                            </span>
                        }
                    </div>
                    <span class="ns-track-caption">
                        @(stepIndex >= 0 ? $"{pipeline[stepIndex]} · step {stepIndex + 1} of {pipeline.Length}" : Model.Status.ToString())
                    </span>
                }
            </div>

            <!-- Items -->
            <h3 class="ns-block-title">
                Items
                <span class="ns-chip ms-1">@items.Count line@(items.Count == 1 ? "" : "s") · @totalUnits unit@(totalUnits == 1 ? "" : "s")</span>
            </h3>

            @if (!items.Any())
            {
                <p class="text-muted small mb-4">This order has no items.</p>
            }
            else
            {
                <div class="ns-item-list mb-4">
                    @foreach (var item in items)
                    {
                        <div class="ns-item-row">
                            <div class="ns-item-thumb">
                                <i class="bi bi-bag"></i>
                            </div>

                            <div class="ns-item-info">
                                <a asp-controller="Admin" asp-action="EditProduct" asp-route-id="@item.ProductId"
                                   class="ns-item-name">@item.Name</a>
                                <div class="ns-item-sub">SKU #@item.ProductId</div>

                                <div class="ns-item-variant">
                                    @if (!string.IsNullOrWhiteSpace(item.Color))
                                    {
                                        <span class="ns-swatch" style="background-color:@item.Color;" title="@item.Color"></span>
                                        <span>@item.Color</span>
                                    }
                                    @if (item.Size != null)
                                    {
                                        if (!string.IsNullOrWhiteSpace(item.Color))
                                        {
                                            <span class="ns-dot-sep">·</span>
                                        }
                                        <span>Size @(item.Size.ToString())</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Color) || item.Size != null)
                                    {
                                        <span class="ns-dot-sep">·</span>
                                    }
                                    <span>Quantity @item.Quantity</span>
                                </div>
                            </div>

                            <div class="ns-item-money">
                                <div class="ns-item-total">EGP @item.TotalPrice.ToString("N2")</div>
                                <div class="ns-item-sub">@item.Quantity × @item.Price.ToString("N2")</div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Notes / cancellation callout -->
            @if (isCancelled)
            {
                <div class="ns-callout ns-callout-danger mb-4">
                    <div class="ns-callout-label">Cancellation Reason</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.CancellationReason) ? "No reason was recorded." : Model.CancellationReason)</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="ns-callout mb-4">
                    <div class="ns-callout-label">Customer Note</div>
                    <div>@Model.Notes</div>
                </div>
            }

            <!-- Payment -->
            <h3 class="ns-block-title d-flex justify-content-between align-items-center">
                <span>Payment</span>
                @if (isCancelled)
                {
                    <span class="ns-flag"><i class="bi bi-slash-circle"></i> Not Collected</span>
                }
            </h3>

            <div class="ns-sum-row">
                <span>Subtotal</span>
                <span>EGP @Model.Subtotal.ToString("N2")</span>
            </div>
            <div class="ns-sum-row">
                <span>Shipping</span>
                <span>
                    @if (Model.ShippingCost == 0)
                    {
                        <span class="ns-text-success fw-bold">Free</span>
                    }
                    else
                    {
                        @($"EGP {Model.ShippingCost:N2}")
                    }
                </span>
            </div>
            @if (Model.Discount.HasValue && Model.Discount.Value > 0)
            {
                var discountMoney = Model.Subtotal * (Model.Discount.Value / 100m);
                
                <div class="ns-sum-row">
                    <span>
                        Discount
                        <span class="text-muted ms-1 fw-normal" style="font-size:0.6875rem;">(@Model.Discount.Value.ToString("0.##")%)</span>
                    </span>
                    <span class="ns-text-danger fw-bold">
                        &minus; EGP @discountMoney.ToString("N2")
                    </span>
                </div>
            }
            
        @if (Model.CouponId != null && Model.Percentage.HasValue && Model.Percentage.Value > 0)
        {
            
            var moneySaved = Model.Subtotal * (Model.Percentage.Value / 100m);

            <div class="ns-sum-row">
                <span>
                    Coupon 
                    <span class="ns-coupon ms-1" title="@Model.Percentage.Value.ToString("0.##")% Off">
                        <i class="bi bi-ticket-perforated"></i> @Model.CouponCode 
                        <span class="text-muted ms-1 fw-normal">(@Model.Percentage.Value.ToString("0.##")%)</span>
                    </span>
                </span>
                <span class="ns-text-danger fw-bold">
                    &minus; EGP @moneySaved.ToString("N2")
                </span>
            </div>
        }

            
            <div class="ns-sum-total">
                <span>Total</span>
                <span class="font-serif">EGP @Model.Total.ToString("N2")</span>
            </div>
        </div>

        <!-- ---------- RIGHT / SIDEBAR ---------- -->
        <aside class="ns-panel-side">

            <!-- Order details -->
            <h3 class="ns-block-title">Order Details</h3>
            <div class="ns-kv-list mb-4">
                <div class="ns-kv">
                    <span class="ns-kv-label">Order ID</span>
                    <span class="ns-kv-value"><i class="bi bi-hash"></i> @Model.Number</span>
                </div>
                <div class="ns-kv">
                    <span class="ns-kv-label">Status</span>
                    <span class="ns-status-badge @statusClass(Model.Status)">
                        <i class="bi @statusIcon(Model.Status)"></i> @Model.Status
                    </span>
                </div>
                <div class="ns-kv">
                    <span class="ns-kv-label">Order Date</span>
                    <span class="ns-kv-value"><i class="bi bi-calendar3"></i> @Model.OrderDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="ns-kv">
                    <span class="ns-kv-label">Total Amount</span>
                    <span class="ns-kv-value fw-bold">EGP @Model.Total.ToString("N2")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
                {
                    <div class="ns-kv">
                        <span class="ns-kv-label">Coupon</span>
                        <span class="ns-kv-value"><i class="bi bi-ticket-perforated"></i> @Model.CouponCode</span>
                    </div>
                }
            </div>

            <hr class="ns-side-rule" />

            <!-- Customer -->
            <h3 class="ns-block-title">Customer Details</h3>
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="ns-avatar ns-avatar-lg">
                    @(string.IsNullOrWhiteSpace(Model.CustomerName) ? "?" : Model.CustomerName.Trim()[0].ToString().ToUpper())
                </span>
                <div class="overflow-hidden">
                    <div class="fw-bold text-truncate">@Model.CustomerName</div>
                    <div class="ns-item-sub">@totalUnits item@(totalUnits == 1 ? "" : "s") in this order</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
            {
                <a href="mailto:@Model.CustomerEmail" class="ns-pill mb-4">
                    <i class="bi bi-envelope"></i> @Model.CustomerEmail
                </a>
            }

            <hr class="ns-side-rule" />

            <!-- Shipping address -->
            <h3 class="ns-block-title">Shipping Address</h3>
            <p class="ns-address mb-0">@Model.ShippingAddress</p>
        </aside>
    </div>

    <!-- ===================== PANEL FOOTER ===================== -->
    <div class="ns-panel-foot ns-no-print">
        <a asp-action="Orders" class="ns-foot-link">
            <i class="bi bi-arrow-left me-1"></i> Back to all orders
        </a>

        <div class="d-flex align-items-center gap-2">
            @{
                var cancelStatus = allStatuses.FirstOrDefault(s =>
                    s.ToString().Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ||
                    s.ToString().Equals("Canceled", StringComparison.OrdinalIgnoreCase));
            }

            @if (!isCancelled && !cancelStatus.Equals(default(OrderStatus)))
            {
                <a asp-action="UpdateStatus" asp-route-Id="@Model.Id" asp-route-status="@cancelStatus"
                   class="ns-foot-link ns-text-danger"
                   onclick="return confirm('Cancel this order? This cannot be undone.');">
                    Cancel Order
                </a>
            }

            <div class="dropdown">
                <button class="ns-apply-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-arrow-repeat me-1"></i> Update Status
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-2">
                    <li>
                        <h6 class="dropdown-header text-uppercase" style="font-size:0.625rem; letter-spacing:.05em;">Move to</h6>
                    </li>
                    @foreach (var st in allStatuses.Where(s => !s.Equals(Model.Status)))
                    {
                        <li>
                            <a class="dropdown-item small d-flex align-items-center gap-2"
                               asp-action="UpdateStatus" asp-route-Id="@Model.Id" asp-route-status="@st">
                                <span style="width:8px; height:8px; border-radius:50%; display:inline-block; flex-shrink:0; background-color:@statusDot(st);"></span>
                                @st
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>


