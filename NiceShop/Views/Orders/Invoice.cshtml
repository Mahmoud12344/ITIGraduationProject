@{
    ViewData["Title"] = "Invoice #ORD-12345";
    Layout = null; // No layout for invoice print view
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - #ORD-12345</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/niceshop.css" />
</head>
<body class="bg-light">

<div class="container my-5 ns-invoice rounded shadow-sm border">
    
    <!-- Action buttons (Hidden when printing) -->
    <div class="d-flex justify-content-end mb-4 ns-no-print gap-2">
        <button class="btn btn-ns-outline" onclick="window.close()">Close</button>
        <button class="btn btn-ns-dark" onclick="window.print()">Print Invoice</button>
    </div>

    <!-- Header -->
    <div class="row mb-5 border-bottom pb-4">
        <div class="col-sm-6">
            <div class="d-flex flex-column lh-1 mb-3">
                <span class="d-flex align-items-baseline gap-1 font-serif fs-3 fw-bold">
                    NICE<span style="font-weight: 300; font-style: italic; color: #fbbf24;">SHOP</span>
                </span>
                <span class="text-uppercase text-muted" style="font-size: 0.5625rem; letter-spacing: 0.25em;">Luxury Fashion</span>
            </div>
            <div class="text-muted small">
                123 Fashion Avenue<br>
                New York, NY 10012<br>
                contact@niceshop.com<br>
                +1 (800) 555-0199
            </div>
        </div>
        <div class="col-sm-6 text-sm-end mt-4 mt-sm-0">
            <h1 class="text-uppercase fw-bold text-muted h4 mb-2">Invoice</h1>
            <div class="fw-bold mb-1">#ORD-12345</div>
            <div class="text-muted small">Date: Jan 01, 2024</div>
        </div>
    </div>

    <!-- Addresses -->
    <div class="row mb-5">
        <div class="col-sm-6">
            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.6875rem; letter-spacing: 0.05em;">Billed To:</div>
            <div class="fw-bold">Customer Name</div>
            <div class="text-muted small">customer@example.com</div>
            <div class="text-muted small mt-1">Payment: <span class="text-uppercase">Credit Card</span></div>
        </div>
        <div class="col-sm-6 mt-4 mt-sm-0 text-sm-end">
            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.6875rem; letter-spacing: 0.05em;">Shipped To:</div>
            <div class="fw-bold">Customer Name</div>
            <div class="text-muted small">
                123 Fashion Ave<br>
                New York, NY 10001<br>
                USA<br>
                555-0199
            </div>
        </div>
    </div>

    <!-- Items -->
    <table class="table mb-4">
        <thead>
            <tr class="text-uppercase text-muted" style="font-size: 0.6875rem;">
                <th scope="col" class="border-bottom-0 pb-2">Item Description</th>
                <th scope="col" class="border-bottom-0 pb-2 text-center">Qty</th>
                <th scope="col" class="border-bottom-0 pb-2 text-end">Price</th>
                <th scope="col" class="border-bottom-0 pb-2 text-end">Amount</th>
            </tr>
        </thead>
        <tbody class="border-top-0">
            <!-- TODO: Loop over Items here -->
            <tr>
                <td class="py-3">
                    <div class="fw-bold" style="font-size: 0.8125rem;">Product Name</div>
                    <div class="text-muted" style="font-size: 0.6875rem;">Size: M | Color: Camel</div>
                </td>
                <td class="py-3 text-center align-middle" style="font-size: 0.8125rem;">1</td>
                <td class="py-3 text-end align-middle" style="font-size: 0.8125rem;">$99.99</td>
                <td class="py-3 text-end align-middle fw-bold" style="font-size: 0.8125rem;">$99.99</td>
            </tr>
        </tbody>
    </table>

    <!-- Totals -->
    <div class="row">
        <div class="col-sm-6">
            <p class="text-muted small">
                <strong>Return Policy:</strong> Returns accepted within 14 days of delivery. Items must be in original condition with tags attached.
            </p>
        </div>
        <div class="col-sm-6">
            <table class="table table-borderless table-sm text-end mb-0">
                <tbody>
                    <tr>
                        <td class="text-muted small">Subtotal:</td>
                        <td class="fw-bold" style="width: 120px;">$99.99</td>
                    </tr>
                    <!-- TODO: Conditionally show discount -->
                    <tr>
                        <td class="text-muted small border-bottom pb-2">Tax:</td>
                        <td class="fw-bold border-bottom pb-2">$5.00</td>
                    </tr>
                    <tr>
                        <td class="fw-bold pt-2 fs-5">Total:</td>
                        <td class="font-serif fw-bold pt-2 fs-4">$104.99</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="text-center mt-5 pt-4 border-top text-muted" style="font-size: 0.75rem;">
        Thank you for shopping with NiceShop.
    </div>

</div>

</body>
</html>
