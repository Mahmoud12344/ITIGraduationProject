@{
    ViewData["Title"] = "Track Order";
}

<div class="bg-dark text-white py-5 mb-4 text-center">
    <h1 class="font-display display-5 fw-bold mb-2">Order Tracking</h1>
    <p class="text-white-50 mx-auto" style="max-width: 500px;">Enter your order number and email address below to track the status of your shipment.</p>
</div>

<div class="container py-4 mb-5" style="max-width: 600px;">
    
    <div class="card ns-bg-card ns-border shadow-sm mb-5">
        <div class="card-body p-4 p-md-5">
            <form method="get" action="/Orders/Track">
                <div class="mb-4">
                    <label class="ns-form-label">Order Number</label>
                    <input type="text" name="orderId" class="ns-form-input" placeholder="e.g., #NS-2024-1234" required>
                </div>
                <div class="mb-4">
                    <label class="ns-form-label">Email Address</label>
                    <input type="email" name="email" class="ns-form-input" placeholder="Used during checkout" required>
                </div>
                <button type="submit" class="btn btn-ns-primary w-100 py-3">Track My Order</button>
            </form>
        </div>
    </div>

    <!-- Example result section (shown only if tracking was successful) -->
    <div class="card border border-success border-2 shadow-sm rounded-4 overflow-hidden">
        <div class="bg-success text-white p-3 text-center">
            <div class="fw-bold text-uppercase" style="letter-spacing: 0.05em; font-Size: 0.75rem;">Status</div>
            <div class="fs-4 fw-bold">SHIPPED</div>
        </div>
        
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <div class="text-muted small">Order Number</div>
                    <div class="fw-bold">#ORD-12345</div>
                </div>
                <div class="text-end">
                    <div class="text-muted small">Order Date</div>
                    <div class="fw-bold">01/01/2024</div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="position-relative mb-5 mt-4 px-3">
                <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: 50%;" aria-valuenow="50" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                
                <div class="position-absolute top-50 translate-middle-y w-100 d-flex justify-content-between" style="left: 0;">
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center border border-3 border-white" style="width: 24px; height: 24px;"><i class="bi bi-check" style="font-Size: 0.75rem;"></i></div>
                    <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center border border-3 border-white" style="width: 24px; height: 24px;"><i class="bi bi-check" style="font-Size: 0.75rem;"></i></div>
                    <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center border border-3 border-white ns-bg-input" style="width: 24px; height: 24px;"></div>
                    <div class="bg-light text-muted rounded-circle d-flex align-items-center justify-content-center border border-3 border-white ns-bg-input" style="width: 24px; height: 24px;"></div>
                </div>
                
                <div class="w-100 d-flex justify-content-between mt-3 text-muted" style="font-Size: 0.6875rem; font-weight: 600;">
                    <span>Confirmed</span>
                    <span>Shipped</span>
                    <span>Out for Delivery</span>
                    <span>Delivered</span>
                </div>
            </div>

            <div class="p-3 bg-light rounded text-center ns-bg-surface border ns-border-light">
                <div class="text-muted small mb-1">Expected Delivery</div>
                <div class="font-serif fw-bold text-success fs-5">
                    Friday, Jan 05
                </div>
            </div>
        </div>
    </div>
</div>
