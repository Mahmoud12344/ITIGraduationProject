@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 shadow" style="width: 80px; height: 80px;">
            <i class="bi bi-check-lg" style="font-size: 2.5rem;"></i>
        </div>
        <h1 class="font-serif fw-bold display-6">Thank You for Your Order</h1>
        <p class="text-muted">A confirmation email has been sent to <strong>customer@example.com</strong>.</p>
    </div>

    <div class="card ns-bg-card ns-border shadow-sm text-start mb-4">
        <div class="card-body p-4 p-md-5">
            <h2 class="h5 fw-bold mb-4 border-bottom pb-2">Order Details</h2>
            
            <div class="row mb-3">
                <div class="col-5 text-muted">Order Number:</div>
                <div class="col-7 fw-bold">#ORD-12345</div>
            </div>
            <div class="row mb-3">
                <div class="col-5 text-muted">Date:</div>
                <div class="col-7">Jan 01, 2024</div>
            </div>
            <div class="row mb-3">
                <div class="col-5 text-muted">Total:</div>
                <div class="col-7 font-serif fw-bold">$150.00</div>
            </div>
            <div class="row mb-3">
                <div class="col-5 text-muted">Payment Method:</div>
                <div class="col-7 text-uppercase">Credit Card</div>
            </div>
            
            <div class="mt-4 pt-4 border-top">
                <h3 class="h6 fw-bold mb-2">Shipping Address</h3>
                <p class="text-muted small mb-0">
                    Customer Name<br>
                    123 Fashion Ave<br>
                    New York, NY 10001<br>
                    USA
                </p>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
        <a href="#" class="btn btn-ns-outline px-4 py-2">Track Order</a>
        <a href="#" class="btn btn-ns-primary px-4 py-2">Continue Shopping</a>
    </div>
</div>
