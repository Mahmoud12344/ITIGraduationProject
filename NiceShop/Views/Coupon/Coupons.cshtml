@model NiceShop.ViewModels.CouponVm
@{
    ViewData["Title"] = "Coupons";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="font-serif h3 fw-bold mb-1">Coupons</h1>
        <p class="text-muted mb-0">Manage discount codes and promotions.</p>
    </div>
    <button class="btn btn-ns-dark" data-bs-toggle="modal" data-bs-target="#addCouponModal">
        <i class="bi bi-plus-lg"></i> Add Coupon
    </button>
</div>

<form method="get" asp-controller="Coupon" asp-action="Coupons" class="ns-admin-card p-3 mb-3 d-flex gap-3">
    <div class="input-group flex-grow-1">
        <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
        <input type="text" name="search" class="form-control" placeholder="Search by coupon code..." value="@Context.Request.Query["search"]" />
    </div>
    <select name="status" class="form-select" style="max-width: 200px;">
        <option value="">All Statuses</option>
        <option value="Active" selected="@(Context.Request.Query["status"] == "Active")">Active</option>
        <option value="Expired" selected="@(Context.Request.Query["status"] == "Expired")">Expired</option>
    </select>
    <button type="submit" class="btn btn-outline-secondary fw-bold" style="min-width: 100px;">FILTER</button>
</form>

<!-- Coupons Table -->
<div class="ns-admin-card p-0 overflow-hidden">
    <table class="table mb-0 align-middle">
        <thead>
        <tr class="ns-admin-border border-bottom">
            <th>CODE</th>
            <th>DISCOUNT</th>
            <th>EXPIRES</th>
            <th>STATUS</th>
            <th class="text-end pe-4">ACTIONS</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var coupon in Model.Coupons)
        {
            <tr class="ns-admin-border border-bottom">
                <td class="fw-bold font-mono">@coupon.Code</td>
                <td>@((int)coupon.Percentage) %</td>
                <td class="text-muted"><i class="bi bi-clock"></i> @coupon.ExpiryDate</td>
                <td>
                    @if (coupon.ExpiryDate < DateTime.Now)
                    {
                        <span class="badge bg-danger">Expired</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Active</span>
                    }
                </td>
                <td class="text-end pe-4">
                    <button class="btn btn-sm btn-link text-muted p-1"
                            data-bs-toggle="modal" data-bs-target="#editCouponModal-@coupon.Id">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-link text-danger p-1"
                            data-bs-toggle="modal" data-bs-target="#deleteCouponModal-@coupon.Id">
                        <i class="bi bi-trash"></i>
                    </button>

                    <div class="modal fade" id="deleteCouponModal-@coupon.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content ns-admin-card border-0">
                                <div class="modal-header border-bottom ns-admin-border">
                                    <h2 class="font-serif h5 fw-bold mb-0">Delete Coupon</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>

                                <div class="modal-body p-4">
                                    <p class="mb-0">
                                        Are you sure you want to delete the coupon <br />
                                        <span class="fw-bold font-mono">@coupon.Code</span>? <br />
                                        This action cannot be undone.
                                    </p>
                                </div>

                                <div class="modal-footer border-top ns-admin-border">
                                    <form asp-controller="Coupon" asp-action="DeleteCoupon" method="post">
                                        <input type="hidden" name="id" value="@coupon.Id" />
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>

            <div class="modal fade" id="editCouponModal-@coupon.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content ns-admin-card border-0">
                        <div class="modal-header border-bottom ns-admin-border">
                            <h2 class="font-serif h5 fw-bold mb-0">Edit Coupon</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <form asp-controller="Coupon" asp-action="EditCoupon" method="post">
                            <input type="hidden" name="Coupon.Id" value="@coupon.Id" />
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label text-muted" style="font-size: 0.75rem;">Coupon Code</label>
                                    <input name="Coupon.Code" type="text" class="form-control font-mono" value="@coupon.Code" />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-muted" style="font-size: 0.75rem;">Expiry Date</label>
                                    <input name="Coupon.ExpiryDate" type="date" class="form-control" value="@coupon.ExpiryDate.ToString("yyyy-MM-dd")" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label text-muted" style="font-size: 0.75rem;">Discount Percentage</label>
                                    <div class="input-group">
                                        <input name="Coupon.Percentage" type="number" class="form-control" value="@coupon.Percentage" min="0" max="100" />
                                        <span class="input-group-text bg-transparent">%</span>
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer border-top ns-admin-border">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-ns-dark"><i class="bi bi-pencil"></i> Save Changes</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
        </tbody>
    </table>
    <div class="d-flex justify-content-between align-items-center p-3">
        <span class="text-muted" style="font-size: 0.875rem;">
            Showing 1 to 10 of 50 entries
        </span>
        <div class="btn-group">
            <button class="btn btn-sm btn-outline-secondary">Previous</button>
            <button class="btn btn-sm btn-outline-secondary">1</button>
            <button class="btn btn-sm btn-outline-secondary">2</button>
            <button class="btn btn-sm btn-outline-secondary">Next</button>
        </div>
    </div>
</div>

<div class="modal fade" id="addCouponModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content ns-admin-card border-0">
            <div class="modal-header border-bottom ns-admin-border">
                <h2 class="font-serif h5 fw-bold mb-0">Add Coupon</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-controller="Coupon" asp-action="CreateCoupon" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label asp-for="@Model.Coupon.Code" class="form-label text-muted" style="font-size: 0.75rem;">Coupon Code</label>
                        <input asp-for="@Model.Coupon.Code" type="text" class="form-control font-mono" placeholder="e.g. SUMMER25" />
                        <span asp-validation-for="@Model.Coupon.Code"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="@Model.Coupon.ExpiryDate" class="form-label text-muted" style="font-size: 0.75rem;">Expiry Date</label>
                        <input asp-for="@Model.Coupon.ExpiryDate" type="date" class="form-control" />
                        <span asp-validation-for="@Model.Coupon.ExpiryDate"></span>
                    </div>

                    <div class="mb-2">
                        <label asp-for="@Model.Coupon.Percentage" class="form-label text-muted" style="font-size: 0.75rem;">Discount Percentage</label>
                        <div class="input-group">
                            <input asp-for="@Model.Coupon.Percentage" type="number" class="form-control" placeholder="10" min="0" max="100" />
                            <span class="input-group-text bg-transparent">%</span>
                        </div>
                        <span asp-validation-for="@Model.Coupon.Percentage"></span>
                    </div>
                </div>

                <div class="modal-footer border-top ns-admin-border">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ns-dark"><i class="bi bi-plus-lg"></i> Save Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>