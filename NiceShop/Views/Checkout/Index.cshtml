@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <div class="row g-5">
        
        <!-- Checkout Form -->
        <div class="col-lg-7">
            <h1 class="font-serif fw-bold h2 mb-4">Checkout</h1>
            
            <form method="post" action="/Checkout/Process">
                
                <!-- Contact Info -->
                <div class="ns-checkout-section mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="ns-checkout-step-number">1</div>
                        <h2 class="font-serif fw-bold h5 mb-0">Contact Information</h2>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="ns-form-label">Email Address</label>
                            <input type="email" class="ns-form-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="ns-form-label">Phone Number</label>
                            <input type="tel" class="ns-form-input" required>
                        </div>
                    </div>
                </div>
                
                <!-- Shipping Address -->
                <div class="ns-checkout-section mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="ns-checkout-step-number">2</div>
                        <h2 class="font-serif fw-bold h5 mb-0">Shipping Address</h2>
                    </div>
                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="ns-form-label">First Name</label>
                            <input type="text" class="ns-form-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="ns-form-label">Last Name</label>
                            <input type="text" class="ns-form-input" required>
                        </div>
                        <div class="col-12">
                            <label class="ns-form-label">Address</label>
                            <input type="text" class="ns-form-input" required>
                        </div>
                        <div class="col-12">
                            <label class="ns-form-label">Apartment, suite, etc. (optional)</label>
                            <input type="text" class="ns-form-input">
                        </div>
                        <div class="col-md-4">
                            <label class="ns-form-label">City</label>
                            <input type="text" class="ns-form-input" required>
                        </div>
                        <div class="col-md-4">
                            <label class="ns-form-label">State</label>
                            <select class="form-select ns-form-input" required>
                                <option value="">Select state...</option>
                                <option value="NY">New York</option>
                                <option value="CA">California</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="ns-form-label">ZIP Code</label>
                            <input type="text" class="ns-form-input" required>
                        </div>
                    </div>
                </div>
                
                <!-- Shipping Method -->
                <div class="ns-checkout-section mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="ns-checkout-step-number">3</div>
                        <h2 class="font-serif fw-bold h5 mb-0">Shipping Method</h2>
                    </div>
                    
                    <div class="d-flex flex-column gap-2">
                        <label class="ns-shipping-card selected d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" name="shippingMethod" value="standard" class="form-check-input mt-0" checked>
                                <div>
                                    <div class="fw-bold">Standard Shipping</div>
                                    <div class="text-muted small">3-5 business days</div>
                                </div>
                            </div>
                            <div class="font-serif fw-bold text-success">Free</div>
                        </label>
                        
                        <label class="ns-shipping-card d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <input type="radio" name="shippingMethod" value="express" class="form-check-input mt-0">
                                <div>
                                    <div class="fw-bold">Express Shipping</div>
                                    <div class="text-muted small">1-2 business days</div>
                                </div>
                            </div>
                            <div class="font-serif fw-bold">$25.00</div>
                        </label>
                    </div>
                </div>
                
                <!-- Payment -->
                <div class="ns-checkout-section mb-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="ns-checkout-step-number">4</div>
                        <h2 class="font-serif fw-bold h5 mb-0">Payment</h2>
                    </div>
                    
                    <p class="text-muted small mb-3"><i class="bi bi-lock me-1"></i> All transactions are secure and encrypted.</p>
                    
                    <div class="d-flex flex-column gap-3">
                        <!-- Credit Card -->
                        <div class="ns-payment-card selected">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <input type="radio" name="paymentMethod" value="card" class="form-check-input mt-0" id="pay-card" checked>
                                <label for="pay-card" class="fw-bold mb-0 flex-grow-1">Credit Card</label>
                                <div class="d-flex gap-1 text-muted fs-5">
                                    <i class="bi bi-credit-card"></i>
                                </div>
                            </div>
                            
                            <!-- Mock Card Form -->
                            <div class="row g-3 px-4 pb-2" id="card-details">
                                <div class="col-12">
                                    <input type="text" class="ns-form-input" placeholder="Card number">
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="ns-form-input" placeholder="Expiration date (MM/YY)">
                                </div>
                                <div class="col-md-6">
                                    <input type="text" class="ns-form-input" placeholder="Security code (CVV)">
                                </div>
                                <div class="col-12">
                                    <input type="text" class="ns-form-input" placeholder="Name on card">
                                </div>
                            </div>
                        </div>
                        
                        <!-- Cash on Delivery -->
                        <div class="ns-payment-card">
                            <div class="d-flex align-items-center gap-2">
                                <input type="radio" name="paymentMethod" value="cod" class="form-check-input mt-0" id="pay-cod">
                                <label for="pay-cod" class="fw-bold mb-0">Cash on Delivery</label>
                            </div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-ns-primary w-100 py-3 fs-6">Pay Now</button>
            </form>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="col-lg-5">
            <div class="position-sticky" style="top: 2rem;">
                <div class="bg-light p-4 p-xl-5 rounded-4 border ns-border-light ns-bg-surface">
                    <h2 class="font-serif fw-bold h5 mb-4">Order Summary</h2>
                    
                    <!-- Items -->
                    <div class="d-flex flex-column gap-3 mb-4 max-h-300 overflow-auto">
                        <!-- TODO: Loop over cart items here -->
                        <div class="d-flex align-items-center gap-3">
                            <div class="position-relative bg-white rounded border ns-border" style="width: 64px; height: 64px; flex-shrink: 0;">
                                <img src="https://images.unsplash.com/photo-1539533018447-63fcce2678e3?w=100" class="w-100 h-100 object-fit-cover rounded p-1">
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">
                                    1
                                </span>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-bold" style="font-size: 0.8125rem;">Product Name</div>
                                <div class="text-muted" style="font-size: 0.6875rem;">M / Camel</div>
                            </div>
                            <div class="font-serif fw-bold" style="font-size: 0.875rem;">$99.99</div>
                        </div>
                    </div>

                    <hr class="ns-border my-4">
                    
                    <!-- Discount Code -->
                    <div class="d-flex gap-2 mb-4">
                        <input type="text" class="ns-form-input flex-grow-1" placeholder="Gift card or discount code">
                        <button class="btn btn-ns-dark px-4">Apply</button>
                    </div>
                    
                    <!-- Totals -->
                    <!-- TODO: Bind these totals to the cart data -->
                    <div class="d-flex justify-content-between mb-2 text-muted" style="font-size: 0.875rem;">
                        <span>Subtotal</span>
                        <span>$99.99</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted" style="font-size: 0.875rem;">
                        <span>Shipping</span>
                        <span>$10.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 text-muted" style="font-size: 0.875rem;">
                        <span>Tax (Estimated)</span>
                        <span>$5.00</span>
                    </div>
                    
                    <hr class="ns-border my-4">
                    
                    <div class="d-flex justify-content-between align-items-end">
                        <span class="fw-bold fs-5">Total</span>
                        <div class="text-end">
                            <span class="text-muted small me-1">USD</span>
                            <span class="font-serif fw-bold fs-3">$114.99</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple UI script for payment selection toggle
    document.addEventListener('DOMContentLoaded', () => {
        const payCards = document.querySelectorAll('.ns-payment-card');
        const cardDetails = document.getElementById('card-details');
        
        payCards.forEach(card => {
            const radio = card.querySelector('input[type="radio"]');
            radio.addEventListener('change', () => {
                payCards.forEach(c => c.classList.remove('selected'));
                if (radio.checked) {
                    card.classList.add('selected');
                    if (radio.value === 'card') {
                        cardDetails.style.display = 'flex';
                    } else {
                        cardDetails.style.display = 'none';
                    }
                }
            });
        });
    });
</script>
