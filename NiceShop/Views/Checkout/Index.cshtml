@model NiceShop.ViewModels.Checkout.CheckoutVM
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <div class="row g-5">

        <!-- Checkout Form -->
        <div class="col-lg-7">
            <h1 class="font-serif fw-bold h2 mb-4">Checkout</h1>

            <!-- Shipping Address -->
            <div class="ns-checkout-section mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="ns-checkout-step-number">1</div>
                    <h2 class="font-serif fw-bold h5 mb-0">Shipping Address</h2>
                </div>

                @if (TempData["AddressError"] != null)
                {
                    <div class="alert alert-danger">@TempData["AddressError"]</div>
                }

                @if (!Model.Addresses.Any())
                {
                    <p class="text-muted">you don't have a saved address yet, add one below.</p>
                }
                else
                {
                    <div class="d-flex flex-column gap-2 mb-3">
                        @foreach (var address in Model.Addresses)
                        {
                            <form method="post" asp-controller="Checkout" asp-action="SelectAddress" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="addressId" value="@address.Id">
                                <label class="ns-shipping-card @(Model.SelectedAddressId == address.Id ? "selected" : "") d-flex align-items-center gap-3">
                                    <input type="radio" name="SelectedAddressIdDisplay" value="@address.Id" class="form-check-input mt-0"
                                           checked="@(Model.SelectedAddressId == address.Id)"
                                           onchange="this.form.submit()">
                                    <div>
                                        <div class="fw-bold">@address.Street, @address.Building</div>
                                        <div class="text-muted small">@address.City, @address.Government - @address.ZipCode</div>
                                        @if (address.IsDefault)
                                        {
                                            <span class="badge bg-secondary">Default</span>
                                        }
                                    </div>
                                </label>
                            </form>
                        }
                    </div>
                }

                <details>
                    <summary class="text-decoration-underline" style="cursor:pointer;">add a new address</summary>
                    <form method="post" asp-controller="Checkout" asp-action="AddAddress" class="row g-3 mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AddressType" value="0">

                        <div class="col-md-6">
                            <label class="ns-form-label">Government</label>
                            <input type="text" name="Government" class="ns-form-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="ns-form-label">City</label>
                            <input type="text" name="City" class="ns-form-input" required>
                        </div>
                        <div class="col-12">
                            <label class="ns-form-label">Street</label>
                            <input type="text" name="Street" class="ns-form-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="ns-form-label">Building</label>
                            <input type="text" name="Building" class="ns-form-input" required>
                        </div>
                        <div class="col-md-6">
                            <label class="ns-form-label">ZIP Code</label>
                            <input type="text" name="ZipCode" class="ns-form-input">
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-ns-dark px-4">Save Address</button>
                        </div>
                    </form>
                </details>
            </div>

            <!-- Payment -->
            <div class="ns-checkout-section mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="ns-checkout-step-number">2</div>
                    <h2 class="font-serif fw-bold h5 mb-0">Payment</h2>
                </div>

                <p class="text-muted small mb-3">this is a simulation, no real payment gateway is used</p>

                @if (TempData["OrderError"] != null)
                {
                    <div class="alert alert-danger">@TempData["OrderError"]</div>
                }

                <form method="post" asp-controller="Checkout" asp-action="PlaceOrder">
                    @Html.AntiForgeryToken()

                    <div class="d-flex flex-column gap-2 mb-3">
                        <label class="ns-payment-card disabled-option fade-on-unselected d-flex align-items-center gap-2">
                            <input type="radio" name="paymentMethod" value="card" class="form-check-input disabled-option fade-on-unselected  mt-0"  disabled   >
                            <span class="fw-bold">Credit Card</span>
                        </label>
                        <label  class="ns-payment-card selected d-flex align-items-center gap-2">
                            <input type="radio" name="paymentMethod" value="cod" class="form-check-input mt-0" checked >
                            <span class="fw-bold">Cash on Delivery</span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-ns-primary w-100 py-3 fs-6" @(Model.SelectedAddressId == null ? "disabled" : "")>
                        Place Order
                    </button>
                </form>
            </div>
        </div>

        <!-- Order Summary Sidebar -->
        <div class="col-lg-5">
            <div class="position-sticky" style="top: 2rem;">
                <div class="bg-light p-4 p-xl-5 rounded-4 border ns-border-light ns-bg-surface">
                    <h2 class="font-serif fw-bold h5 mb-4">Order Summary</h2>

                    <div class="d-flex flex-column gap-3 mb-4 max-h-300 overflow-auto">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center gap-3">
                                <div class="position-relative bg-white rounded border ns-border" style="width: 64px; height: 64px; flex-shrink: 0;">
                                    <img src="@(item.ImageUrl ?? "/images/placeholder.png")" class="w-100 h-100 object-fit-cover rounded p-1">
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">
                                        @item.Quantity
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-bold" style="font-size: 0.8125rem;">@item.ProductName</div>
                                    <div class="text-muted" style="font-size: 0.6875rem;">@item.Size / @item.Color</div>
                                </div>
                                <div class="font-serif fw-bold" style="font-size: 0.875rem;">EGP @item.LineTotal.ToString("0.00")</div>
                            </div>
                        }
                    </div>

                    <hr class="ns-border my-4">

                    @if (TempData["CouponError"] != null)
                    {
                        <div class="alert alert-danger py-2">@TempData["CouponError"]</div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-success">coupon "@Model.AppliedCouponCode" applied</span>
                            <form method="post" asp-controller="Checkout" asp-action="RemoveCoupon">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link btn-sm p-0">remove</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <form method="post" asp-controller="Checkout" asp-action="ApplyCoupon" class="d-flex gap-2 mb-4">
                            @Html.AntiForgeryToken()
                            <input type="text" name="couponCode" class="ns-form-input flex-grow-1" placeholder="Gift card or discount code">
                            <button type="submit" class="btn btn-ns-dark px-4">Apply</button>
                        </form>
                    }

                    <div class="d-flex justify-content-between mb-2 text-muted" style="font-size: 0.875rem;">
                        <span>Subtotal</span>
                        <span>EGP @Model.Cart.Subtotal.ToString("0.00")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success" style="font-size: 0.875rem;">
                            <span>Discount</span>
                            <span>-EGP @Model.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }

                    <hr class="ns-border my-4">

                    <div class="d-flex justify-content-between align-items-end">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="font-serif fw-bold fs-3">EGP @Model.Total.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
            document.addEventListener('DOMContentLoaded', () => {
                const payCards = document.querySelectorAll('.ns-payment-card');
                payCards.forEach(card => {
                    const radio = card.querySelector('input[type="radio"]');
                    radio.addEventListener('change', () => {
                        payCards.forEach(c => c.classList.remove('selected'));
                        if (radio.checked) card.classList.add('selected');
                    });
                });
            });
    </script>
</div>