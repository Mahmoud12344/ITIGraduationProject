@model NiceShop.Models.Order
@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="font-serif fw-bold h2 mb-2">Thank you, your order is confirmed!</h1>
        <p class="text-muted">Order number: <strong>@Model.Number</strong></p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="bg-light p-4 p-xl-5 rounded-4 border ns-border-light ns-bg-surface">
                <h2 class="font-serif fw-bold h5 mb-4">Order Summary</h2>

                <div class="d-flex flex-column gap-3 mb-4">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">@item.Name</div>
                                <div class="text-muted small">@item.Size / @item.Color x @item.Quantity</div>
                            </div>
                            <div class="font-serif fw-bold">EGP @((item.Price * item.Quantity).ToString("0.00"))</div>
                        </div>
                    }
                </div>

                <hr class="ns-border my-4">

                <div class="d-flex justify-content-between mb-2 text-muted">
                    <span>Subtotal</span>
                    <span>EGP @Model.Subtotal.ToString("0.00")</span>
                </div>
                @if (Model.Discount is > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Discount</span>
                        <span>-EGP @Model.Discount</span>
                    </div>
                }
                <div class="d-flex justify-content-between mb-2 text-muted">
                    <span>Shipping</span>
                    <span>EGP @Model.ShippingCost.ToString("0.00")</span>
                </div>

                <hr class="ns-border my-4">

                <div class="d-flex justify-content-between align-items-end">
                    <span class="fw-bold fs-5">Total</span>
                    <span class="font-serif fw-bold fs-3">EGP @Model.Total.ToString("0.00")</span>
                </div>
            </div>

            <div class="text-center mt-4">
                <a href="/" class="btn btn-ns-dark px-4">Continue Shopping</a>
            </div>
        </div>
    </div>
</div>