@{
    ViewData["Title"] = "My Wishlist";
}

<div class="container py-5">
    
    <div class="d-flex justify-content-between align-items-end border-bottom ns-border-light pb-3 mb-4">
        <div>
            <h1 class="font-display display-6 fw-bold mb-1">My Wishlist</h1>
            <p class="text-muted mb-0">Saved items you want to keep an eye on.</p>
        </div>
        <div class="text-muted small d-none d-md-block">
            <!-- TODO: Bind item count here -->
            3 Items
        </div>
    </div>

    <!-- TODO: Add IF condition to show empty state when wishlist is empty -->
    <!--
    <div class="text-center py-5 bg-light rounded-4 ns-bg-surface">
        <i class="bi bi-heart display-1 text-muted opacity-25 mb-4"></i>
        <h2 class="font-serif fw-bold h4">Your wishlist is empty</h2>
        <p class="text-muted mb-4">Save items you love by clicking the heart icon on any product.</p>
        <a href="#" class="btn btn-ns-dark px-4 py-2">Discover New Arrivals</a>
    </div>
    -->

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <!-- TODO: Loop over wishlist products here -->
        <div class="col">
            <div class="position-relative">
                <!-- Make the heart icon active by default since it's in the wishlist -->
                <div class="position-absolute top-0 end-0 m-2 z-2">
                    <button class="ns-wishlist-btn active position-relative top-0 end-0" onclick="window.nsCart.toggleWishlist(this, 'product-id'); this.closest('.col').style.opacity = '0.5';">
                        <i class="bi bi-heart-fill text-danger"></i>
                    </button>
                </div>
                
                <partial name="Partials/_ProductCard" />
            </div>
        </div>
    </div>

</div>
