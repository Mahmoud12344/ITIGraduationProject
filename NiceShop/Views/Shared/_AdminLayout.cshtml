<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - @ViewData["Title"] - NiceShop</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    
    <!-- Custom Brand Styles (Includes Admin theme overrides) -->
    <link rel="stylesheet" href="~/css/niceshop.css" asp-append-version="true" />
</head>
<body class="ns-admin-body">
    
    <div class="d-flex">
        
        <!-- Sidebar Navigation -->
        <aside class="ns-admin-sidebar p-3 d-none d-lg-flex">
            <div class="d-flex align-items-center mb-4 px-2">
                <i class="bi bi-hexagon-fill ns-text-gold fs-4 me-2"></i>
                <span class="font-serif fs-5 fw-bold">NiceShop Admin</span>
            </div>
            
            <nav class="flex-grow-1">
                <a href="#" class="ns-sidebar-link active">
                    <i class="bi bi-grid-1x2"></i> Dashboard
                </a>
                <a href="#" class="ns-sidebar-link">
                    <i class="bi bi-box-seam"></i> Products
                </a>
                <a href="#" class="ns-sidebar-link">
                    <i class="bi bi-cart3"></i> Orders
                </a>
                <a href="#" class="ns-sidebar-link">
                    <i class="bi bi-star"></i> Reviews
                </a>
                <a href="#" class="ns-sidebar-link">
                    <i class="bi bi-tags"></i> Categories & Coupons
                </a>
            </nav>
            
            <div class="mt-auto pt-4 border-top ns-border">
                <div class="d-flex align-items-center justify-content-between px-2 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <div style="width: 32px; height: 32px; border-radius: 50%; background-color: var(--ns-bg-elevated); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person text-muted"></i>
                        </div>
                        <div>
                            <div class="fw-bold" style="font-Size: 0.75rem;">Admin User</div>
                            <div class="text-muted" style="font-Size: 0.625rem;">admin@niceshop.com</div>
                        </div>
                    </div>
                </div>
                
                <div class="d-flex gap-2">
                    <button class="ns-theme-toggle flex-grow-1 py-1" aria-label="Toggle theme">
                        <i class="bi bi-sun"></i>
                    </button>
                    <a href="#" class="btn btn-ns-outline flex-grow-1 py-1 px-2 d-flex align-items-center justify-content-center gap-1" style="font-Size: 0.6875rem;">
                        <i class="bi bi-shop"></i> Store
                    </a>
                </div>
            </div>
        </aside>
        
        <!-- Main Content Area -->
        <main class="flex-grow-1">
            <!-- Mobile Header -->
            <header class="d-lg-none bg-dark p-3 d-flex justify-content-between align-items-center border-bottom ns-border">
                <div class="d-flex align-items-center">
                    <i class="bi bi-hexagon-fill ns-text-gold fs-5 me-2"></i>
                    <span class="font-serif fw-bold text-white">NiceShop</span>
                </div>
                <button class="btn text-white" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminMobileMenu">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </header>
            
            <div class="p-4 p-md-5">
                @RenderBody()
            </div>
        </main>
        
    </div>

    <!-- Mobile Offcanvas Menu (Simplified for brevity) -->
    <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="adminMobileMenu">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title font-serif"><i class="bi bi-hexagon-fill ns-text-gold me-2"></i>Admin Panel</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-0">
            <!-- Same links as sidebar -->
            <div class="p-3">
                <a href="#" class="d-block text-white text-decoration-none py-2 border-bottom border-secondary">Dashboard</a>
                <a href="#" class="d-block text-white text-decoration-none py-2 border-bottom border-secondary">Products</a>
                <a href="#" class="d-block text-white text-decoration-none py-2 border-bottom border-secondary">Orders</a>
                <a href="#" class="d-block text-white text-decoration-none py-2 mt-4 text-warning">View Storefront</a>
            </div>
        </div>
    </div>

    <partial name="Partials/_Toast" />

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JS -->
    <script src="~/js/niceshop.js" asp-append-version="true"></script>
    <script src="~/js/niceshop-admin.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
