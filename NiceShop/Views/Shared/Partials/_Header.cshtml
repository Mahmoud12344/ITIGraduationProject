    <!-- Actions -->
<div class="d-flex align-items-center gap-3">
    
    <!-- Theme Toggle (Always visible) -->
    <button class="ns-theme-toggle d-none d-md-flex" aria-label="Toggle theme">
        <i class="bi bi-moon"></i>
    </button>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- 1. Account Dropdown -->
        <div class="dropdown d-none d-md-block">
            <a href="#" 
               class="btn btn-link text-decoration-none text-muted p-2" 
               data-bs-toggle="dropdown" 
               aria-expanded="false">
                <i class="bi bi-person fs-5"></i>
            </a>
            
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                <li>
                    <span class="dropdown-item-text fw-bold text-truncate small  " style="max-width: 200px; display: block;">
                        @User.Identity.Name
                    </span>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <a href="#" class="dropdown-item">My Orders</a>
                </li>
                <li>
                    <a asp-controller="Auth" asp-action="SignOut" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                    </a>
                </li>
            </ul>
        </div>

        <!-- 2. Wishlist -->
        <a href="#" class="btn btn-link text-decoration-none text-muted p-2 position-relative d-none d-md-block">
            <i class="bi bi-heart fs-5"></i>
        </a>
        
        <!-- 3. Cart -->
        <button class="ns-cart-btn position-relative" type="button" data-bs-toggle="offcanvas" data-bs-target="#cartDrawer">
            <i class="bi bi-bag"></i>
            <span class="d-none d-md-inline ms-1 fw-bold">Cart</span>
            <span class="ns-cart-badge">2</span>
        </button>
    }
    else
    {
        <!-- Logged Out: Show ONLY the Sign In / Register button -->
        <a asp-controller="Auth" asp-action="Index" class="btn btn-link text-decoration-none text-muted p-2 d-none d-md-block" title="Sign In / Register">
            <i class="bi bi-person fs-5"></i>
            <span class="d-none d-md-inline ms-1 fw-bold">Sign In</span>
        </a>
    }
</div>
    
    
    
</div>

<!-- 3. Navigation Bar -->
<div class="ns-nav-bar px-3 px-lg-5 d-none d-lg-flex justify-content-center align-items-center py-2 position-relative">
    <nav class="d-flex gap-2">
        <a href="#" class="ns-nav-link active">Home</a>
        
        <div class="position-relative d-inline-block" id="nav-collections-dropdown">
            <button class="ns-nav-link d-flex align-items-center gap-1">
                Collections <i class="bi bi-chevron-down ms-1" style="font-Size:0.6rem;"></i>
            </button>
            <!-- Mega Menu -->
            <div class="ns-mega-menu d-none">
                <div class="row gx-5">
                    <div class="col-4">
                        <div class="ns-mega-menu-heading">Categories</div>
                        <a href="#" class="ns-mega-menu-link">Women's Ready-to-Wear</a>
                        <a href="#" class="ns-mega-menu-link">Men's Tailoring</a>
                        <a href="#" class="ns-mega-menu-link">Outerwear & Coats</a>
                        <a href="#" class="ns-mega-menu-link">Leather Goods</a>
                        <a href="#" class="ns-mega-menu-link">Footwear</a>
                        <a href="#" class="ns-mega-menu-link">Accessories & Watches</a>
                    </div>
                    <div class="col-4">
                        <div class="ns-mega-menu-heading">Featured Brands</div>
                        <a href="#" class="ns-mega-menu-link">Maison Noir</a>
                        <a href="#" class="ns-mega-menu-link">Atelier Luxe</a>
                        <a href="#" class="ns-mega-menu-link">Verona Milan</a>
                        <a href="#" class="ns-mega-menu-link">Silk & Wool</a>
                    </div>
                    <div class="col-4">
                        <div class="ns-mega-promo text-center h-100 d-flex flex-column justify-content-center">
                            <i class="bi bi-stars fs-3 mb-2" style="color: var(--ns-gold);"></i>
                            <div class="font-serif fw-bold mb-1">Spring Collection</div>
                            <p class="small text-muted mb-3">Discover the new arrivals directly from Paris.</p>
                            <a href="#" class="btn-ns-primary w-100 text-decoration-none d-inline-block">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <a href="#" class="ns-nav-link">Shop</a>
        <a href="#" class="ns-nav-link ns-sale-link">Flash Sale</a>
        <a href="#" class="ns-nav-link">Track Order</a>
        @if (User.IsInRole("Admin")){
            <a href="#" class="ns-nav-link text-info ms-4"><i class="bi bi-shield-lock"></i> Admin</a>
        }
        </nav>
</div>

<script>
    // Mega Menu Hover Logic
    document.addEventListener('DOMContentLoaded', function() {
        const dropdown = document.getElementById('nav-collections-dropdown');
        const menu = dropdown?.querySelector('.ns-mega-menu');
        if(dropdown && menu) {
            dropdown.addEventListener('mouseenter', () => menu.classList.remove('d-none'));
            dropdown.addEventListener('mouseleave', () => menu.classList.add('d-none'));
        }
    });
</script>
