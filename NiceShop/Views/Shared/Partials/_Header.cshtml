<!-- 1. Announcement Bar -->
<div class="ns-announcement-bar d-flex justify-content-between align-items-center">
    <div class="d-none d-md-flex align-items-center gap-2">
        <i class="bi bi-telephone"></i>
        <span>+1 (800) 555-0199</span>
    </div>
    
    <div class="d-flex align-items-center justify-content-center gap-2 flex-grow-1">
        <span>Complimentary Express Shipping on Orders Over <span class="ns-gold-text fw-bold">$200</span></span>
        <a href="#" class="text-decoration-none border-bottom border-secondary ms-2" style="color: inherit;">Shop Now</a>
    </div>
    
    <div class="d-none d-md-flex align-items-center gap-3">
        <a href="#" class="text-decoration-none" style="color: inherit;">Find a Boutique</a>
        <span>|</span>
        <span>USD ($)</span>
    </div>
</div>

<!-- 2. Main Brand Bar -->
<div class="ns-navbar py-3 px-3 px-lg-5 d-flex align-items-center justify-content-between">
    <!-- Logo -->
    <a  asp-action="Index" asp-controller="Home" class="ns-brand d-flex align-items-center gap-2">
        <i class="bi bi-hexagon-fill fs-3" style="color: var(--ns-gold);"></i>
        <div class="d-flex flex-column lh-1 mt-1">
            <span class="d-flex align-items-baseline gap-1">
                NICE<span class="ns-brand-italic">SHOP</span>
                <span class="ns-brand-tag ms-1">Maison</span>
            </span>
            <span class="ns-brand-subtitle mt-1">Luxury Fashion</span>
        </div>
    </a>

    <!-- Search -->
    <div class="d-none d-lg-block mx-4" style="flex: 1; max-width: 500px; position: relative;">
        <div class="ns-search-form">
            <select aria-label="Category select">
                <option value="all">All</option>
                <option value="women">Women</option>
                <option value="men">Men</option>
                <option value="accessories">Accessories</option>
            </select>
            <input type="text" id="nav-search-input" placeholder="Search for luxury items, brands, or collections..." autocomplete="off">
            <button type="button" aria-label="Search"><i class="bi bi-search"></i></button>
        </div>
        
        <!-- Search Dropdown Container (populated by JS) -->
        <div id="nav-search-dropdown" class="ns-search-dropdown d-none"></div>
    </div>

