<footer class="ns-footer">
    <div class="container py-4">
        <div class="row g-5">
            <!-- Brand Column -->
            <div class="col-12 col-lg-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-hexagon-fill fs-3" style="color: var(--ns-gold);"></i>
                    <div class="d-flex flex-column lh-1 mt-1">
                        <span class="d-flex align-items-baseline gap-1 font-serif fs-5 fw-bold">
                            NICE<span style="font-weight: 300; font-style: italic; color: var(--ns-gold);">SHOP</span>
                            <span class="bg-dark text-warning rounded px-1 ms-1 text-uppercase" style="font-Size: 0.625rem; font-weight:700; letter-spacing:0.08em; padding: 0.125rem 0.375rem;">Maison</span>
                        </span>
                        <span class="mt-1 text-muted text-uppercase" style="font-Size: 0.5625rem; letter-spacing: 0.25em;">Luxury Fashion</span>
                    </div>
                </div>
                <p class="text-muted small mb-4" style="line-height: 1.6; max-width: 90%;">
                    Curating the world's most exceptional fashion. We bring Parisian elegance, Italian craftsmanship, and modern design directly to your wardrobe.
                </p>
                <div class="ns-footer-heading">Join The Maison</div>
                <p class="text-muted" style="font-Size: 0.75rem;">Subscribe for exclusive access to limited collections and private sales.</p>
                <form class="d-flex mt-3" style="max-width: 300px;">
                    <input type="email" class="form-control form-control-sm bg-transparent border-secondary text-white" placeholder="Email Address" style="border-radius: 0.375rem 0 0 0.375rem; border-right: none;">
                    <button class="btn btn-outline-secondary" type="button" style="border-radius: 0 0.375rem 0.375rem 0; border-color: var(--bs-secondary); color: var(--ns-gold);">Subscribe</button>
                </form>
            </div>

            <!-- Links Column 1 -->
            <div class="col-6 col-md-4 col-lg-2 offset-lg-1">
                <div class="ns-footer-heading">Shop</div>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="@Url.Action("Index", "Products", new { category = "women" })" class="text-decoration-none">Women's Collection</a></li>
                    <li><a href="@Url.Action("Index", "Products", new { category = "men" })" class="text-decoration-none">Men's Tailoring</a></li>
                    <li><a href="@Url.Action("Index", "Products", new { category = "leather-goods" })" class="text-decoration-none">Leather Goods</a></li>
                    <li><a href="@Url.Action("Index", "Products", new { category = "accessories" })" class="text-decoration-none">Fine Accessories</a></li>
                    <li><a href="@Url.Action("Index", "Products", new { sort = "new" })" class="text-decoration-none">New Arrivals</a></li>
                </ul>
            </div>

            <!-- Links Column 2 -->
            <div class="col-6 col-md-4 col-lg-2">
                <div class="ns-footer-heading">Customer Care</div>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                    <li><a href="#" class="text-decoration-none">Contact Us</a></li>
                    <li><a href="@Url.Action("Index", "Orders")" class="text-decoration-none">Track Your Order</a></li>
                    <li><a href="#" class="text-decoration-none">Shipping & Returns</a></li>
                    <li><a href="#" class="text-decoration-none">Size Guide</a></li>
                    <li><a href="#" class="text-decoration-none">Care Instructions</a></li>
                </ul>
            </div>

            <!-- Links Column 3 -->
            <div class="col-12 col-md-4 col-lg-3">
                <div class="ns-footer-heading">The Brand</div>
                <ul class="list-unstyled d-flex flex-column gap-2 mb-4">
                    <li><a href="#" class="text-decoration-none">Our Heritage</a></li>
                    <li><a href="#" class="text-decoration-none">Sustainability</a></li>
                    <li><a href="#" class="text-decoration-none">Boutiques</a></li>
                    <li><a href="#" class="text-decoration-none">Careers</a></li>
                </ul>
                
                <div class="ns-footer-heading">Connect</div>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted"><i class="bi bi-instagram fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-twitter-x fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-pinterest fs-5"></i></a>
                    <a href="#" class="text-muted"><i class="bi bi-youtube fs-5"></i></a>
                </div>
            </div>
        </div>

        <div class="ns-copyright d-flex flex-column flex-md-row justify-content-between align-items-center">
            <p class="mb-2 mb-md-0">&copy; @DateTime.Now.Year NiceShop Luxury Fashion. All rights reserved.</p>
            <div class="d-flex gap-3">
                <a href="#" class="text-decoration-none text-muted">Privacy Policy</a>
                <a href="#" class="text-decoration-none text-muted">Terms of Service</a>
                <a href="#" class="text-decoration-none text-muted">Accessibility</a>
            </div>
        </div>
    </div>
</footer>
