@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center py-5">

            <!-- Icon -->
            <div class="mb-4">
                <i class="bi bi-exclamation-diamond display-1" style="color: var(--ns-text-muted); opacity: 0.5;"></i>
            </div>

            <!-- Heading -->
            <h1 class="font-display fw-bold display-5 mb-3">Oops, Something Went Wrong</h1>
            <p class="text-muted mb-4" style="font-size: 1rem; line-height: 1.7; max-width: 420px; margin: 0 auto;">
                We couldn't process your request. Please try again or head back to the homepage.
            </p>

            <!-- Request ID (dev info) -->
            @if (Model.ShowRequestId)
            {
                <div class="d-inline-block rounded px-3 py-2 mb-4" style="background-color: var(--ns-bg-surface); border: 1px solid var(--ns-border-light);">
                    <span class="text-muted" style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Request ID</span>
                    <br/>
                    <code style="font-size: 0.8rem; color: var(--ns-text-secondary);">@Model.RequestId</code>
                </div>
            }

            <!-- Actions -->
            <div class="d-flex justify-content-center gap-3 mt-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-ns-dark px-4">Back to Home</a>
                <button onclick="history.back()" class="btn btn-ns-outline px-4">Go Back</button>
            </div>

        </div>
    </div>
</div>