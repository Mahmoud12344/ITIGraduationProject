@model IEnumerable<NiceShop.Models.Category>
@{
    ViewData["Title"] = "Categories & Coupons";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Categories & Coupons</h1>
        <p class="text-muted mb-0">Manage taxonomy and discount codes.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Categories List -->
    <div class="col-lg-6">
        <div class="ns-admin-card h-100 p-0 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom ns-admin-border">
                <h2 class="font-serif h5 fw-bold mb-0">Categories</h2>
                <button class="btn btn-sm btn-ns-dark" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </div>
            <div class="p-3">
                <ul class="list-group list-group-flush">
                    @foreach (var category in Model)
                    {
                        <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-3 border-bottom ns-admin-border">
                            <div class="d-flex align-items-center gap-3">
                                <div>
                                    <div class="fw-bold text-body">@category.Name</div>
                                    <div class="text-muted small">@category.Slug</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <form asp-action="DeleteCategory" method="post" onsubmit="return confirm('Delete this category?');">
                                    <input type="hidden" name="id" value="@category.Id" />
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-1">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }

                    @if (!Model.Any())
                    {
                        <li class="list-group-item bg-transparent text-muted text-center py-3">No categories yet.</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Coupons List (سيبها زي ما هي دلوقتي) -->
    <div class="col-lg-6">
        <div class="ns-admin-card h-100 p-0 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom ns-admin-border">
                <h2 class="font-serif h5 fw-bold mb-0">Discount Coupons</h2>
                <button class="btn btn-sm btn-ns-dark"><i class="bi bi-plus-lg"></i> Add</button>
            </div>
            <div class="p-3">
                <p class="text-muted text-center py-3">Coupons management coming soon.</p>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddCategory" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug</label>
                        <input type="text" name="slug" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-ns-dark">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>