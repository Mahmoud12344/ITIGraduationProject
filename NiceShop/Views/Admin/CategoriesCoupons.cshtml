@{
    ViewData["Title"] = "Categories & Coupons";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Categories & Coupons</h1>
        <p class="text-muted mb-0">Manage taxonomy and discount codes.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Categories List -->
    <div class="col-lg-6">
        <div class="ns-admin-card h-100 p-0 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom ns-admin-border">
                <h2 class="font-serif h5 fw-bold mb-0">Categories</h2>
                <button class="btn btn-sm btn-ns-dark"><i class="bi bi-plus-lg"></i> Add</button>
            </div>
            <div class="p-3">
                <ul class="list-group list-group-flush">
                    <!-- TODO: Loop over Categories here -->
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-3 border-bottom ns-admin-border">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded" style="width: 40px; height: 40px; overflow: hidden; flex-shrink: 0;">
                                <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?q=80&w=2070" class="w-100 h-100 object-fit-cover">
                            </div>
                            <div>
                                <div class="fw-bold text-body">Category Name</div>
                                <div class="text-muted small">category-slug</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="badge bg-secondary">10 Items</span>
                            <div>
                                <button class="btn btn-sm btn-link text-muted p-1"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-link text-danger p-1"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Coupons List -->
    <div class="col-lg-6">
        <div class="ns-admin-card h-100 p-0 overflow-hidden">
            <div class="d-flex justify-content-between align-items-center p-4 border-bottom ns-admin-border">
                <h2 class="font-serif h5 fw-bold mb-0">Discount Coupons</h2>
                <button class="btn btn-sm btn-ns-dark"><i class="bi bi-plus-lg"></i> Add</button>
            </div>
            <div class="p-3">
                <ul class="list-group list-group-flush">
                    <!-- TODO: Loop over Coupons here -->
                    <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-3 border-bottom ns-admin-border">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="fw-bold font-mono">COUPONCODE</div>
                                <!-- TODO: Conditionally apply badge based on IsActive -->
                                <span class="badge bg-success">Active</span>
                            </div>
                            <div class="text-muted mt-1" style="font-size: 0.75rem;">
                                10% OFF | Min Purchase: $50.00
                            </div>
                            <!-- TODO: Conditionally show Expiry Date -->
                            <div class="text-muted mt-1" style="font-size: 0.6875rem;"><i class="bi bi-clock"></i> Expires: Jan 01, 2024</div>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            <span class="text-muted" style="font-size: 0.6875rem;">Used 5 times</span>
                            <div>
                                <button class="btn btn-sm btn-link text-muted p-1"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-link text-danger p-1"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
