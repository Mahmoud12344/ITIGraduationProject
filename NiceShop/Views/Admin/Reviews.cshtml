@{
    ViewData["Title"] = "Customer Reviews";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Reviews</h1>
        <p class="text-muted mb-0">Manage customer feedback and ratings.</p>
    </div>
</div>

<div class="ns-admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover ns-admin-table mb-0">
            <thead>
                <tr>
                    <th style="width: 200px;">Customer</th>
                    <th style="width: 200px;">Product</th>
                    <th style="width: 120px;">Rating</th>
                    <th>Comment</th>
                    <th style="width: 100px;">Date</th>
                    <th class="text-end" style="width: 150px;">Action</th>
                </tr>
            </thead>
            <tbody>
                <!-- TODO: Loop over Reviews here -->
                <tr>
                    <td>
                        <div class="fw-bold">Customer Name</div>
                        <!-- TODO: Conditionally show Verified Purchase badge -->
                        <div class="text-success" style="font-size: 0.625rem;"><i class="bi bi-patch-check-fill"></i> Verified Purchase</div>
                    </td>
                    <td>
                        <!-- Typically populated via Include(r => r.Product). Assuming Product object is loaded here -->
                        <a href="#" class="text-decoration-none text-body fw-bold line-clamp-1" target="_blank">
                            Product Name
                        </a>
                    </td>
                    <td>
                        <div class="ns-stars">
                            <!-- TODO: Render stars based on rating -->
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                    </td>
                    <td>
                        <p class="mb-0 line-clamp-2" title="Review comment goes here">Review comment goes here</p>
                    </td>
                    <td>Jan 01, 2024</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-ns-outline py-1" onclick="window.nsAdmin.toggleReviewVisibility(this, 'review-id')">
                            Hide
                        </button>
                        <button class="btn btn-sm btn-link text-danger p-1 ms-1" title="Delete" data-confirm="Are you sure you want to delete this review?"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
