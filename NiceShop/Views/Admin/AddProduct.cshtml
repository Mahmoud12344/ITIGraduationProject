@model NiceShop.Models.Product

@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form id="addProductForm" asp-action="AddProduct" method="post">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="font-serif fw-bold h3 mb-1">Add Product</h1>
            <p class="text-muted mb-0">Create a new item in your catalog.</p>
        </div>
        <div>
            <a asp-action="Products" class="btn btn-ns-outline btn-sm me-2">Cancel</a>
            <button type="submit" class="btn btn-ns-dark btn-sm">Save Product</button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column (Main Info) -->
        <div class="col-lg-8">
            <div class="ns-admin-card p-4 h-100">
                <h2 class="h6 fw-bold mb-4">General Information</h2>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                    <input asp-for="Name" class="form-control bg-light border-light" placeholder="e.g. Silk Evening Gown" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                    <textarea asp-for="Description" class="form-control bg-light border-light" rows="4" placeholder="Describe the product details..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Price" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                        <input asp-for="Price" class="form-control bg-light border-light" placeholder="0.00" />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Stock" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                        <input asp-for="Stock" class="form-control bg-light border-light" value="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Discount" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                        <input asp-for="Discount" class="form-control bg-light border-light" placeholder="Optional" />
                        <span asp-validation-for="Discount" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column (Organization) -->
        <div class="col-lg-4">
            <div class="ns-admin-card p-4 mb-4">
                <h2 class="h6 fw-bold mb-4">Organization</h2>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Category</label>
                    <select asp-for="CategoryId" class="form-select ns-form-input" asp-items="ViewBag.CategoryId">
                        <option value="">Select Category...</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Brand</label>
                    <select asp-for="BrandId" class="form-select ns-form-input" asp-items="ViewBag.BrandId">
                        <option value="">-- None --</option>
                    </select>
                </div>

                <div class="mb-0">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsBestseller" class="form-check-input" />
                        <label asp-for="IsBestseller" class="form-check-label"></label>
                    </div>
                    <div class="form-check">
                        <input asp-for="IsOnSale" class="form-check-input" />
                        <label asp-for="IsOnSale" class="form-check-label"></label>
                    </div>
                </div>
            </div>
        </div>
    </div>

</form>