
@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Add Product</h1>
        <p class="text-muted mb-0">Create a new item in your catalog.</p>
    </div>
    <div>
        <a href="#" class="btn btn-ns-outline btn-sm me-2">Cancel</a>
        <button type="submit" form="addProductForm" class="btn btn-ns-dark btn-sm">Save Product</button>
    </div>
</div>

<form id="addProductForm" method="post" action="#" class="row g-4" enctype="multipart/form-data">
    <!-- Left Column (Main Info) -->
    <div class="col-lg-8">
        <div class="ns-admin-card p-4 h-100">
            <h2 class="h6 fw-bold mb-4">General Information</h2>
            
            <div class="mb-3">
                <label for="Name" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Product Name</label>
                <input type="text" class="form-control bg-light border-light" id="Name" name="Name" placeholder="e.g. Silk Evening Gown" required>
            </div>
            
            <div class="mb-3">
                <label for="Description" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Description</label>
                <textarea class="form-control bg-light border-light" id="Description" name="Description" rows="4" placeholder="Describe the product details..." required></textarea>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="Price" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Price ($)</label>
                    <input type="number" step="0.01" class="form-control bg-light border-light" id="Price" name="Price" placeholder="0.00" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="OriginalPrice" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Original Price ($)</label>
                    <input type="number" step="0.01" class="form-control bg-light border-light" id="OriginalPrice" name="OriginalPrice" placeholder="Optional">
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column (Organization & Media) -->
    <div class="col-lg-4">
        <div class="ns-admin-card p-4 mb-4">
            <h2 class="h6 fw-bold mb-4">Organization</h2>
            
            <div class="mb-3">
                <label for="Category" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Category</label>
                    <select class="form-select ns-form-input" id="productCategory" required>
                        <option value="">Select Category...</option>
                        <!-- TODO: Loop over Categories -->
                        <option value="category-slug">Category Name</option>
                    </select>
            </div>
            
            <div class="mb-3">
                <label for="Brand" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Brand</label>
                    <select class="form-select ns-form-input" id="productBrand" required>
                        <option value="">Select Brand...</option>
                        <!-- TODO: Loop over Brands -->
                        <option value="brand-id">Brand Name</option>
                    </select>
            </div>

            <div class="mb-3">
                <label for="Sku" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">SKU</label>
                <input type="text" class="form-control bg-light border-light" id="Sku" name="Sku" placeholder="e.g. NS-10294" required>
            </div>
            
            <div class="mb-0">
                <label for="Stock" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Inventory Count</label>
                <input type="number" class="form-control bg-light border-light" id="Stock" name="Stock" value="0" required>
            </div>
        </div>
        
        <div class="ns-admin-card p-4">
            <h2 class="h6 fw-bold mb-4">Media</h2>
            <div class="mb-3">
                <label for="Images" class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Product Images</label>
                <div class="border border-2 border-dashed rounded p-4 text-center ns-border-light position-relative bg-light">
                    <i class="bi bi-cloud-arrow-up fs-2 text-muted mb-2"></i>
                    <p class="small text-muted mb-0">Drag & drop images here or</p>
                    <button type="button" class="btn btn-link text-body fw-bold p-0 text-decoration-none" onclick="document.getElementById('Images').click()">Browse files</button>
                    <input type="file" id="Images" name="Images" multiple accept="image/*" class="position-absolute w-100 h-100 top-0 start-0 opacity-0 cursor-pointer" style="cursor:pointer;" />
                </div>
            </div>
        </div>
    </div>
</form>
