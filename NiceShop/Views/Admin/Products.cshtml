@model IEnumerable<NiceShop.Models.Product>

@{
    ViewData["Title"] = "Products Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Products</h1>
        <p class="text-muted mb-0">Manage your inventory, pricing, and product details.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="AddProduct" class="btn btn-ns-dark btn-sm"><i class="bi bi-plus-lg me-1"></i> Add Product</a>
    </div>
</div>

<div class="ns-admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover ns-admin-table mb-0">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category & Brand</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold line-clamp-1" style="max-width: 250px;">@product.Name</div>
                            <div class="text-muted" style="font-Size: 0.6875rem;">ID: @product.Id</div>
                        </td>
                        <td>
                            <div>@(product.Category?.Name ?? "-")</div>
                            <div class="text-muted" style="font-Size: 0.6875rem;">@(product.Brand?.Name ?? "-")</div>
                        </td>
                        <td>
                            <div class="fw-bold">@product.Price.ToString("C")</div>
                        </td>
                        <td>
                            @product.Stock
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="ns-toggle-active is-active">Active</span>
                            }
                            else
                            {
                                <span class="ns-toggle-active">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-link text-muted p-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="DeleteProduct" method="post" style="display:inline" onsubmit="return confirm('Delete this product?');">
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" class="btn btn-sm btn-link text-danger p-1" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4 mb-0">No products found. Start by adding one.</p>
    }
</div>