@{
    ViewData["Title"] = "Products Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Products</h1>
        <p class="text-muted mb-0">Manage your inventory, pricing, and product details.</p>
    </div>
    
    <div class="d-flex gap-2">
        <!-- Would normally trigger a modal for a new product -->
        <a href="#" class="btn btn-ns-dark btn-sm"><i class="bi bi-plus-lg me-1"></i> Add Product</a>
    </div>
</div>

<div class="ns-admin-card mb-4">
    <form method="get" class="row g-3">
        <div class="col-md-5">
            <div class="position-relative">
                <input type="text" name="SearchQuery" class="ns-form-input pe-4" placeholder="Search by name or SKU...">
                <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-2 text-muted"></i>
            </div>
        </div>
        <div class="col-md-3">
            <select name="CategoryFilter" class="form-select ns-form-input">
                <option value="">All Categories</option>
                <!-- TODO: Loop over Categories -->
                <option value="category-slug">Category Name</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-ns-outline w-100">Filter</button>
        </div>
    </form>
</div>

<div class="ns-admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover ns-admin-table mb-0">
            <thead>
                <tr>
                    <th style="width: 40px;">
                        <input type="checkbox" class="form-check-input mt-0">
                    </th>
                    <th>Product</th>
                    <th>Category & Brand</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- TODO: Loop over Products -->
                <tr>
                    <td>
                        <input type="checkbox" class="form-check-input mt-0" value="product-id">
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-light rounded" style="width: 40px; height: 40px; overflow: hidden; flex-shrink: 0;">
                                <img src="https://images.unsplash.com/photo-1539533018447-63fcce2678e3?w=100" class="w-100 h-100 object-fit-cover">
                            </div>
                            <div>
                                <div class="fw-bold line-clamp-1" style="max-width: 250px;">Product Name</div>
                                <div class="text-muted" style="font-Size: 0.6875rem;">SKU: ITEM-SKU</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div>Category Name</div>
                        <div class="text-muted" style="font-Size: 0.6875rem;">Brand Name</div>
                    </td>
                    <td>
                        <div class="fw-bold">$99.99</div>
                        <!-- TODO: Conditionally show original price if on sale -->
                        <div class="text-muted text-decoration-line-through" style="font-Size: 0.6875rem;">$129.99</div>
                    </td>
                    <td>
                        <div class="ns-stock-adjuster">
                            <button type="button" onclick="window.nsAdmin.updateStock('product-id', -1)"><i class="bi bi-dash"></i></button>
                            <input type="number" id="stock-product-id" value="10" class="form-control form-control-sm text-center bg-transparent border-0 px-0" style="width: 40px; font-weight: bold; box-shadow: none;" readonly>
                            <button type="button" onclick="window.nsAdmin.updateStock('product-id', 1)"><i class="bi bi-plus"></i></button>
                        </div>
                    </td>
                    <td>
                        <!-- TODO: Toggle active class and text based on product status -->
                        <button type="button" class="ns-toggle-active is-active" onclick="window.nsAdmin.toggleProductActive(this, 'product-id')">
                            Active
                        </button>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-link text-muted p-1" title="Edit"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-sm btn-link text-danger p-1" title="Delete" data-confirm="Are you sure you want to delete this product?"><i class="bi bi-trash"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
    <!-- Pagination (Simplified) -->
    <div class="d-flex justify-content-between align-items-center p-3 border-top ns-admin-border bg-light ns-bg-surface">
        <div class="text-muted small">Showing 1 to 10 of 50 entries</div>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
            <li class="page-item active"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">Next</a></li>
        </ul>
    </div>
</div>
