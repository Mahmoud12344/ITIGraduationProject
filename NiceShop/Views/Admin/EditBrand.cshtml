@model NiceShop.Models.Brand
@{
    ViewData["Title"] = "Edit Brand";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- edit message -->
@if (TempData["BrandSuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["BrandSuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<!-- ===============  -->

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="font-serif fw-bold h3 mb-1">Edit Brand</h1>
        <p class="text-muted mb-0">Update details.</p>
    </div>
    <div>
        <a asp-action="Brands" class="btn btn-ns-outline btn-sm me-2">Cancel</a>
        <button type="submit" form="editBrandForm" class="btn btn-ns-dark btn-sm">Save Changes</button>
    </div>
</div>

<div class="ns-admin-card p-4">
    <form id="editBrandForm" asp-action="EditBrand" method="post" enctype="multipart/form-data">
        
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageId" />

        <div class="row">
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                    <input asp-for="Name" class="form-control bg-light border-light" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="Country" class="form-label fw-semibold small text-muted text-uppercase tracking-wider"></label>
                    <input asp-for="Country" class="form-control bg-light border-light" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold small text-muted text-uppercase tracking-wider">Update Brand Image</label>
                    <input type="file" name="imageFile" class="form-control bg-light border-light" accept="image/*" />
                    <div class="form-text">Leave this blank if you want to keep the current image.</div>
                </div>
            </div>

            <!-- Display current image as a preview -->
            <div class="col-md-4 d-flex flex-column align-items-center justify-content-center border-start">
                <p class="fw-semibold small text-muted text-uppercase tracking-wider mb-2">Current Image</p>
                @if (Model.Image != null)
                {
                    <img src="@Model.Image.FilePath" class="img-fluid rounded shadow-sm" alt="Current Image" style="max-height: 200px;" />
                }
                else
                {
                    <div class="rounded bg-light border d-flex flex-column align-items-center justify-content-center text-muted" style="width: 100%; height: 200px;">
                        <i class="bi bi-image mb-2" style="font-size: 2rem;"></i>
                        <span class="small">No Image</span>
                    </div>
                }
            </div>
        </div>
    </form>
</div>