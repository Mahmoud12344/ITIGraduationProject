@model NiceShop.ViewModels.AuthVM

<div class="container py-5 my-md-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <!-- Tabs -->
            <ul class="nav nav-tabs mb-4 border-bottom ns-border"
                id="authTabs"
                role="tablist">

                <!-- Sign In -->
                <li class="nav-item flex-grow-1 text-center"
                    role="presentation">

                    <a asp-controller="Auth"
                       asp-action="Index"
                       class="nav-link @(Model.ActiveTab == "login" ? "active" : "")
                              w-100 fw-bold border-0 bg-transparent text-muted
                              px-0 pb-3"
                       id="login-tab"
                       style="border-bottom: 2px solid transparent !important;">

                        Sign In

                    </a>

                </li>

                <!-- Create Account -->
                <li class="nav-item flex-grow-1 text-center"
                    role="presentation">

                    <a asp-controller="Auth"
                       asp-action="CreateAccount"
                       class="nav-link @(Model.ActiveTab == "register" ? "active" : "")
                              w-100 fw-bold border-0 bg-transparent text-muted
                              px-0 pb-3"
                       id="register-tab"
                       style="border-bottom: 2px solid transparent !important;">

                        Create Account

                    </a>

                </li>

            </ul>


            <!-- Content -->
            <div class="tab-content" id="authTabsContent">

                @if (Model.ActiveTab == "login")
                {
                    <!-- Login Form -->
                    <div class="tab-pane fade show active"
                         id="login"
                         role="tabpanel">

                        <div class="card ns-bg-card ns-border shadow-sm border-0 rounded-4 p-2 p-md-4">

                            <div class="card-body">

                                <h2 class="font-serif h4 fw-bold mb-4 text-center">
                                    Welcome Back
                                </h2>

                                <form action="#" method="post">

                                    <div class="mb-3">

                                        <label class="ns-form-label">
                                            Email Address
                                        </label>

                                        <input type="email"
                                               class="ns-form-input"
                                               required>

                                    </div>


                                    <div class="mb-4">

                                        <div class="d-flex justify-content-between align-items-center mb-1">

                                            <label class="ns-form-label mb-0">
                                                Password
                                            </label>

                                            <a href="#"
                                               class="text-muted text-decoration-none"
                                               style="font-size: 0.6875rem;">

                                                Forgot Password?

                                            </a>

                                        </div>

                                        <input type="password"
                                               class="ns-form-input"
                                               required>

                                    </div>


                                    <button type="submit"
                                            class="btn btn-ns-dark w-100 py-2">

                                        Sign In

                                    </button>

                                </form>


                                <div class="position-relative text-center my-4">

                                    <hr class="ns-border">

                                    <span class="position-absolute top-50 start-50 translate-middle px-3 text-muted small bg-light ns-bg-card">
                                        OR
                                    </span>

                                </div>


                                <button type="button"
                                        class="btn btn-ns-outline w-100 py-2 d-flex align-items-center justify-content-center gap-2">

                                    <i class="bi bi-google"></i>
                                    Continue with Google

                                </button>

                            </div>

                        </div>

                    </div>
                }


                @if (Model.ActiveTab == "register")
                {
                    <!-- Register Form -->
                    <div class="tab-pane fade show active"
                         id="register"
                         role="tabpanel">

                        <partial name="Partilas/CreateAccount"
                                 model="Model.Register" />

                    </div>
                }

            </div>

        </div>
    </div>
</div>


<style>

    /* Add specific active styling for the tabs just for this page */

    .nav-tabs .nav-link.active {
        color: var(--ns-text) !important;
        border-bottom-color: var(--ns-text) !important;
    }

</style>


@section Scripts
{
    <partial name="Partials/_ValidationScriptsPartial" />
}