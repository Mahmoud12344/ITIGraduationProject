@model NiceShop.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = ViewBag.RelatedProducts as List<NiceShop.Models.Product>;
}

<div class="container py-4 pb-5">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-Size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
            <li class="breadcrumb-item"><a asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index">Shop</a></li>
            <li class="breadcrumb-item"><a asp-action="ByCategory" asp-route-id="@Model.CategoryId">@(Model.Category?.Name ?? "")</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="row g-5 mb-5">
        <!-- Product Images -->
        <div class="col-lg-7">
            <div class="row g-2">
                <div class="col-2 d-flex flex-column gap-2" style="max-height: 500px; overflow-y: auto;">
                    @if (Model.Images.Any())
                    {
                        var index = 0;
                        foreach (var image in Model.Images)
                        {
                            <div class="border ns-border-light rounded p-1 cursor-pointer @(index == 0 ? "border-dark" : "")"
                                 onclick="document.getElementById('mainImage').src = this.querySelector('img').src;">
                                <img src="@image.FilePath" class="w-100 object-fit-cover rounded" style="aspect-ratio: 3/4;" alt="@image.Name">
                            </div>
                            index++;
                        }
                    }
                </div>

                <!-- Main Image -->
                <div class="col-10">
                    <div class="bg-light rounded overflow-hidden position-relative h-100">
                        <img src="@(Model.Images.Any() ? Model.Images.First().FilePath : "https://images.unsplash.com/photo-1539533018447-63fcce2678e3?w=800")"
                             class="w-100 h-100 object-fit-cover" alt="@Model.Name" id="mainImage">

                        <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-2">
                            @if (Model.IsOnSale && Model.Discount.HasValue)
                            {
                                <span class="ns-badge-sale px-2 py-1 fs-6 rounded" style="background-color: #dc3545; color: white;">
                                    @Model.Discount% OFF
                                </span>
                            }
                        </div>

                        <!-- Wishlist -->
                        <button class="ns-wishlist-btn m-3 border-0 bg-white rounded-circle shadow-sm position-absolute top-0 end-0" style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;" onclick="window.nsCart.toggleWishlist(this, '@Model.Id')">
                            <i class="bi bi-heart fs-5"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Info -->
        <div class="col-lg-5">
            <div class="d-flex flex-column h-100">

                <div class="mb-3">
                    <a href="#" class="text-uppercase text-muted fw-bold text-decoration-none" style="font-size: 0.75rem; letter-spacing: 0.08em;">
                        @(Model.Brand?.Name ?? "NiceShop Exclusive")
                    </a>
                    <h1 class="font-serif fw-bold display-6 mt-1 mb-2">@Model.Name</h1>

                    <div class="d-flex align-items-center gap-3">
                        <div class="font-serif fw-bold fs-3">@Model.Price.ToString("C")</div>
                        @if (Model.IsOnSale && Model.Discount.HasValue)
                        {
                            decimal discountFraction = Model.Discount.Value / 100m;
                            decimal originalPrice = Model.Price / (1m - discountFraction);
                            <div class="text-muted text-decoration-line-through fs-5">@originalPrice.ToString("C")</div>
                        }
                    </div>

                    <div class="d-flex align-items-center gap-2 mt-2">
                        <div class="ns-stars text-warning">
                            @{
                                var fullStars = (int)Math.Floor(Model.Rating);
                                var hasHalfStar = (Model.Rating - fullStars) >= 0.5m;
                            }
                            @for (int i = 0; i < fullStars; i++) { <i class="bi bi-star-fill"></i> }
                            @if (hasHalfStar) { <i class="bi bi-star-half"></i> }
                            @for (int i = fullStars + (hasHalfStar ? 1 : 0); i < 5; i++) { <i class="bi bi-star"></i> }

                            <span class="text-muted ms-2 small">@Model.Rating (@Model.ReviewCount Reviews)</span>
                        </div>
                    </div>
                </div>

                <p class="text-muted mb-4" style="line-height: 1.6;">@Model.Description</p>

                <form method="post" action="/Cart/Add" class="mb-4 pb-4 border-bottom ns-border-light">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    @if (Model.Colors.Any())
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="ns-form-label mb-0">Color: <span class="text-body ms-1 fw-normal" id="selectedColorLabel">@Model.Colors.First().Name</span></label>
                            </div>
                            <div class="d-flex gap-2">
                                @foreach (var color in Model.Colors)
                                {
                                    <button type="button" class="btn p-0 border border-dark rounded-circle" style="width: 32px; height: 32px; padding: 2px !important;" title="@color.Name"
                                            onclick="document.getElementById('selectedColorLabel').innerText='@color.Name'; document.getElementById('selectedColorInput').value='@color.Name';">
                                        <div class="w-100 h-100 rounded-circle" style="background-color: @color.HexCode;"></div>
                                    </button>
                                }
                            </div>
                            <input type="hidden" name="color" id="selectedColorInput" value="@Model.Colors.First().Name" />
                        </div>
                    }

                    @if (Model.Sizes.Any())
                    {
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="ns-form-label mb-0">Size: <span class="text-body ms-1 fw-normal" id="selectedSizeLabel">@Model.Sizes.First().Name</span></label>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var size in Model.Sizes)
                                {
                                    <button type="button" class="btn btn-outline-dark px-3 py-1" style="font-Size: 0.75rem;"
                                            onclick="document.getElementById('selectedSizeLabel').innerText='@size.Name'; document.getElementById('selectedSizeInput').value='@size.Name';">
                                        @size.Name
                                    </button>
                                }
                            </div>
                            <input type="hidden" name="Size" id="selectedSizeInput" value="@Model.Sizes.First().Name" />
                        </div>
                    }
                    else if (Model.Stock > 0)
                    {
                        <div class="d-flex align-items-center gap-2 mb-3 text-warning" style="font-size: 0.75rem;">
                            <i class="bi bi-exclamation-circle-fill"></i> <span class="fw-bold">Low Stock — Only @Model.Stock remaining</span>
                        </div>
                    }

                    <div class="d-flex align-items-center gap-2 mb-3" style="font-Size: 0.75rem;">
                        @if (Model.Stock == 0)
                        {
                            <i class="bi bi-x-circle text-danger"></i> <span>Out of Stock</span>
                        }
                        else if (Model.Stock <= 5)
                        {
                            <i class="bi bi-exclamation-circle text-warning"></i> <span>Low Stock — Only @Model.Stock left</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle text-success"></i> <span>In Stock — Ready to Ship</span>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <div class="d-flex align-items-center border rounded px-2" style="background: var(--ns-bg-input);">
                            <button type="button" class="btn btn-link text-body p-2 text-decoration-none" onclick="this.nextElementSibling.stepDown()"><i class="bi bi-dash"></i></button>
                            <input type="number" name="quantity" class="form-control border-0 bg-transparent text-center p-0" value="1" min="1" max="@(Model.Stock > 0 ? Model.Stock : 1)" style="width: 40px; box-shadow: none;">
                            <button type="button" class="btn btn-link text-body p-2 text-decoration-none" onclick="this.previousElementSibling.stepUp()"><i class="bi bi-plus"></i></button>
                        </div>

                        <button type="submit" class="btn btn-ns-dark flex-grow-1" @(Model.Stock == 0 ? "disabled" : "")>
                            <i class="bi bi-bag me-2"></i> @(Model.Stock == 0 ? "Sold Out" : "Add to Bag")
                        </button>
                    </div>
                </form>

                <div class="accordion accordion-flush" id="productAccordion">
                    <div class="accordion-item bg-transparent border-bottom ns-border-light">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-transparent px-0 py-3 shadow-none fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDetails">
                                Product Details
                            </button>
                        </h2>
                        <div id="collapseDetails" class="accordion-collapse collapse" data-bs-parent="#productAccordion">
                            <div class="accordion-body px-0 pt-0 pb-3 text-muted small">
                                <ul class="mb-0 ps-3">
                                    <li>Category: @(Model.Category?.Name ?? "General")</li>
                                    <li>Brand: @(Model.Brand?.Name ?? "General")</li>
                                    <li>Added: @Model.CreatedAt.ToString("MMMM yyyy")</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="accordion-item bg-transparent border-bottom ns-border-light">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-transparent px-0 py-3 shadow-none fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseShipping">
                                Shipping & Returns
                            </button>
                        </h2>
                        <div id="collapseShipping" class="accordion-collapse collapse" data-bs-parent="#productAccordion">
                            <div class="accordion-body px-0 pt-0 pb-3 text-muted small">
                                <p class="mb-2"><strong>Complimentary Express Shipping</strong> on all orders over EGP 200. Delivery typically takes 2-4 business days.</p>
                                <p class="mb-0"><strong>Free Returns</strong> within 14 days of delivery. Items must be in original condition with tags attached.</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <section class="mt-5 pt-5 border-top ns-border-light">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="font-serif fw-bold h3 mb-0">Customer Reviews (@Model.ReviewCount)</h2>
        </div>

        @if (TempData["ReviewSuccess"] != null)
        {
            <div class="alert alert-success" style="font-size: 0.9rem;">@TempData["ReviewSuccess"]</div>
        }
        @if (TempData["ReviewError"] != null)
        {
            <div class="alert alert-danger" style="font-size: 0.9rem;">@TempData["ReviewError"]</div>
        }

        @{
            var approvedReviews = Model.Reviews.Where(r => r.IsApproved).OrderByDescending(r => r.Date).ToList();
        }

        @if (approvedReviews.Any())
        {
            foreach (var review in approvedReviews)
            {
                <div class="mb-4 pb-4 border-bottom ns-border-light">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <strong>@(review.Customer?.FName ?? "Anonymous")</strong>
                            @if (review.IsVerifiedUser)
                            {
                                <span class="badge ms-2" style="background-color:#198754; color:#fff; font-size:0.65rem;">
                                    <i class="bi bi-patch-check-fill me-1"></i>Verified Purchase
                                </span>
                            }
                            <div class="ns-stars text-warning mt-1" style="font-size: 0.8rem;">
                                @for (int i = 0; i < review.Rating; i++) { <i class="bi bi-star-fill"></i> }
                                @for (int i = review.Rating; i < 5; i++) { <i class="bi bi-star"></i> }
                            </div>
                        </div>
                        <span class="text-muted small">@review.Date.ToString("MMM dd, yyyy")</span>
                    </div>
                    <p class="text-muted mb-0">@review.Content</p>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No reviews yet. Be the first to review this product.</p>
        }

        <!-- Write a Review Form -->
        <div class="mt-5 pt-4 border-top ns-border-light">
            <h3 class="font-serif fw-bold h5 mb-3">Write a Review</h3>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
           <form asp-controller="Products" asp-action="AddReview" method="post" class="mb-3" style="max-width: 600px;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ProductId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="ns-form-label mb-2 d-block">Your Rating</label>
                        <div class="ns-star-input d-flex gap-1 fs-3" style="cursor: pointer;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star star-icon" data-value="@i" style="color:#ccc;"></i>
                            }
                        </div>
                        <input type="hidden" name="Rating" id="selectedRatingInput" value="0" />
                    </div>

                    <div class="mb-3">
                        <label class="ns-form-label mb-2 d-block">Your Review</label>
                        <textarea name="Content" class="form-control" rows="4" placeholder="Tell us what you think about this product..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-ns-dark px-4">
                        <i class="bi bi-send me-2"></i>Submit Review
                    </button>
                </form>
            }
            else
            {
                <p class="text-muted">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Log in</a>
                    to write a review.
                </p>
            }
        </div>
    </section>

    <!-- You May Also Like -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <section class="mt-5 pt-5 border-top ns-border-light">
            <div class="text-center mb-4">
                <h2 class="font-serif fw-bold h3">You May Also Like</h2>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @foreach (var related in relatedProducts)
                {
                    <div class="col">
                        <partial name="Partials/_ProductCard" model="related" />
                    </div>
                }
            </div>
        </section>
    }
    @section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const stars = document.querySelectorAll('.ns-star-input .star-icon');
            const ratingInput = document.getElementById('selectedRatingInput');

            function paintStars(count) {
                stars.forEach(function (star) {
                    const value = parseInt(star.dataset.value);
                    if (value <= count) {
                        star.classList.remove('bi-star');
                        star.classList.add('bi-star-fill');
                        star.style.color = '#ffc107';
                    } else {
                        star.classList.remove('bi-star-fill');
                        star.classList.add('bi-star');
                        star.style.color = '#ccc';
                    }
                });
            }

            stars.forEach(function (star) {
                star.addEventListener('mouseenter', function () {
                    paintStars(parseInt(star.dataset.value));
                });

                star.addEventListener('click', function () {
                    const value = star.dataset.value;
                    ratingInput.value = value;
                    paintStars(parseInt(value));
                });
            });

            document.querySelector('.ns-star-input').addEventListener('mouseleave', function () {
                paintStars(parseInt(ratingInput.value));
            });
        });
    </script>
}
</div>