@model IEnumerable<NiceShop.Models.Category>

<div class="container mt-5">
    <h1 class="mb-4">Shop by Category</h1>

    <div class="row g-4">
        @foreach (var category in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title">@category.Name</h5>
                        <a asp-action="ByCategory" asp-route-id="@category.Id" class="btn btn-outline-dark mt-2">
                            Browse @category.Name
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No categories available right now.</p>
    }
</div>