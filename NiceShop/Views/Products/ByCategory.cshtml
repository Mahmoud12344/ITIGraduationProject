@model IEnumerable<NiceShop.Models.Product>

<div class="container mt-5">
    <h1 class="ns-section-title mb-4">@ViewBag.CategoryName</h1>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted fs-5">No products found in this category yet.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-ns-outline mt-3">Return to Home</a>
        </div>
    }
    else
    {
        <!-- The Grid Setup -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-5">
            @foreach (var product in Model)
            {
                <div class="col">
                    <partial name="Partials/_ProductCard" model="product" />
                </div>
            }
        </div>
    }
</div>