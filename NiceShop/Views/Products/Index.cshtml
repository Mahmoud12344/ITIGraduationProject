
@{
    ViewData["Title"] = "Shop All";
}

<!-- Page Header -->
<div class="bg-dark text-white py-5 mb-4 position-relative overflow-hidden">
    <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?w=1600" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover opacity-25" alt="Banner">
    <div class="container position-relative z-1 text-center py-4">
        <h1 class="font-display display-4 fw-bold mb-2">The Collection</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0" style="font-Size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;">
                <li class="breadcrumb-item"><a href="#" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Shop</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container pb-5">
    
    <!-- Top Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom ns-border-light gap-3">
        <div class="text-muted" style="font-Size: 0.8125rem;">
            Showing <span class="fw-bold text-body">12</span> of <span class="fw-bold text-body">120</span> Products
        </div>
        
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <label for="sortSelect" class="text-muted text-uppercase fw-bold" style="font-Size: 0.6875rem; letter-spacing: 0.05em;">Sort By</label>
                <select id="sortSelect" class="form-select form-select-sm border-0 bg-transparent fw-bold" style="width: auto; cursor: pointer;">
                    <option value="featured">Featured</option>
                    <option value="new">Newest Arrivals</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                </select>
            </div>
            
            <div class="d-lg-none">
                <button class="btn btn-ns-outline py-1 px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#filterSidebar">
                    <i class="bi bi-funnel"></i> Filters
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar Filters (Desktop) -->
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="ns-filter-sidebar">
                
                <!-- Search -->
                <div class="mb-4">
                    <div class="ns-filter-label">Search</div>
                    <div class="position-relative">
                        <input type="text" class="ns-form-input pe-4" placeholder="Search products...">
                        <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-2 text-muted"></i>
                    </div>
                </div>

                <!-- Categories -->
                <div class="mb-4 border-top ns-border-light pt-4">
                    <div class="ns-filter-label mb-3">Categories</div>
                    <div class="d-flex flex-column gap-2">
                        <!-- TODO: Loop over Categories here. Each category needs an Id, Name, and ItemCount. Determine 'checked' state based on filters. -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cat-1">
                            <label class="form-check-label text-muted d-flex justify-content-between" for="cat-1" style="font-Size: 0.8125rem;">
                                <span>Category Name</span>
                                <span class="opacity-50">120</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Brands -->
                <div class="mb-4 border-top ns-border-light pt-4">
                    <div class="ns-filter-label mb-3">Brands</div>
                    <div class="d-flex flex-column gap-2">
                        <!-- TODO: Loop over Brands here. Each brand needs an Id, Name, and ProductCount. -->
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="brand-1">
                            <label class="form-check-label text-muted d-flex justify-content-between" for="brand-1" style="font-Size: 0.8125rem;">
                                <span>Brand Name</span>
                                <span class="opacity-50">45</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Price Range -->
                <div class="mb-4 border-top ns-border-light pt-4">
                    <div class="ns-filter-label mb-3">Price Range</div>
                    <input type="range" class="form-range" min="0" max="2000" id="priceRange">
                    <div class="d-flex justify-content-between text-muted mt-2" style="font-Size: 0.75rem;">
                        <span>$0</span>
                        <span>$2,000+</span>
                    </div>
                </div>
                
                <!-- Availability -->
                <div class="mb-4 border-top ns-border-light pt-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="inStockSwitch">
                        <label class="form-check-label ns-filter-label ms-2" for="inStockSwitch" style="margin-bottom: 0;">In Stock Only</label>
                    </div>
                </div>
                
                <button class="btn btn-ns-dark w-100">Apply Filters</button>

            </div>
        </aside>

        <!-- Product Grid -->
        <main class="col-12 col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                <!-- TODO: Loop over Products here. Render a _ProductCard partial for each. Add a 'No products found' state conditionally. -->
                <div class="col">
                    <partial name="Partials/_ProductCard" />
                </div>
            </div>
            
            <!-- Pagination -->
            <!-- Pagination -->
            <!-- TODO: Conditionally render pagination and loop over page numbers -->
            <nav class="mt-5 d-flex justify-content-center" aria-label="Page navigation">
                <ul class="pagination pagination-sm">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" aria-label="Previous">
                            <span aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                        </a>
                    </li>
                    <li class="page-item active">
                        <a class="page-link" href="#">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#" aria-label="Next">
                            <span aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                        </a>
                    </li>
                </ul>
            </nav>
        </main>
    </div>
</div>

<!-- Mobile Filter Offcanvas -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="filterSidebar" aria-labelledby="filterSidebarLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title font-serif fw-bold" id="filterSidebarLabel"><i class="bi bi-funnel me-2"></i>Filters</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <!-- Content duplicated from aside above for mobile view. Ideally use a PartialView for filters. -->
        <p class="text-muted small">Filters content goes here...</p>
    </div>
</div>
